{
["arg2"] = "Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1742696951,
["arg1"] = "Bon, ce partenariat n’était pas si pourri. Ça me rappelle que faire des affaires avec les gogos de l’Alliance peut parfois rapporter gros.",
},
{
["arg2"] = "Gila Filkistouch",
["type"] = "MONSTER_SAY",
["time"] = 1742696957,
["arg1"] = "Grâce aux qualités de meneur du maître-bricoleur Suprétincelle, la menace d’une annihilation planétaire fut écartée.",
},
{
["arg2"] = "Maître-bricoleur Suprétincelle",
["type"] = "MONSTER_SAY",
["time"] = 1742696964,
["arg1"] = "Oh ! et n’oubliez pas de mentionner le tour de force technique que j’ai réalisé en démantelant ces monstres mécaniques !",
},
{
["arg2"] = "Gila Filkistouch",
["type"] = "MONSTER_SAY",
["time"] = 1742696970,
["arg1"] = "Bien entendu, monsieur !",
},
