{
["arg2"] = "Faerley",
["type"] = "MONSTER_SAY",
["time"] = 1724506272,
["arg1"] = "Une punition collective, donc.",
},
{
["arg2"] = "Edwyn Forgevent",
["type"] = "MONSTER_SAY",
["time"] = 1724506273,
["arg1"] = "Et je dis que vous devez m’aider. Alors au travail !",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506292,
["arg1"] = "Proviseur Fynch, désolée de vous déranger chez vous, mais…",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506294,
["arg1"] = "Qu’y a-t-il, Sophietta ? Ce doit être important pour que vous veniez jusqu’ici.",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506298,
["arg1"] = "En fait, je ne suis pas désolée. Je sais que vous voulez être juste, mais la situation ne l’est pas.",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506305,
["arg1"] = "Edwyn a volé mon rapport et m’a empêchée de le remettre. En acceptant mon rapport, vous rétabliriez l’équité.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506309,
["arg1"] = "Sophietta, j’en ai discuté avec Kronf et j’ai pris une décision.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506312,
["arg1"] = "Votre travail a toujours été excellent jusque-là, alors si j’accepte votre rapport, vous serez notre prochaine capitaine d’aéronef.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506320,
["arg1"] = "Edwyn est juste derrière vous, et Jenae Sacrepique n’est pas loin derrière lui.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506323,
["arg1"] = "Kronf m’a assuré qu’il ne serait pas injuste d’accepter votre rapport en retard.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506327,
["arg1"] = "Félicitations, Sophietta, vous serez bientôt capitaine, avec Edwyn et Jenae comme officiers.",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506327,
["arg1"] = "La journée a été longue, proviseur Fynch. Je vais aller dîner et vous laisser manger.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506331,
["arg1"] = "Très bien. Merci, Sophietta.",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506331,
["arg1"] = "Merci de faire ce qui est juste, proviseur Fynch.",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506332,
["arg1"] = "Merci pour votre aide, Kronf !",
},
{
["arg2"] = "Sophietta Lynflayme",
["type"] = "MONSTER_SAY",
["time"] = 1724506334,
["arg1"] = "Nous ferons tout le maximum pour faire la fierté de Luilumière.",
},
{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506337,
["arg1"] = "Je sais que vous accomplirez brillamment votre devoir. Tout ce que vous avez accompli ici m’en donne la certitude.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724506475,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Aemyra Acton",
["type"] = "MONSTER_SAY",
["time"] = 1724506489,
["arg1"] = "Des fleurs ? Je suppose que c’est Orren qui vous envoie. Il est si attentionné !",
},
{
["arg2"] = "Aemyra Acton",
["type"] = "MONSTER_SAY",
["time"] = 1724506494,
["arg1"] = "C’est vraiment difficile de s’éprendre de quelqu’un lorsque votre vocation vous pousse dans des directions différentes.",
},
{
["arg2"] = "Taenar Robustoth",
["type"] = "MONSTER_SAY",
["time"] = 1724506509,
["arg1"] = "Je suis déçu de voir que Velhan ne s’en est pas occupé. Même si ça ne me surprend pas.",
},
{
["arg2"] = "Aemyra Acton",
["type"] = "MONSTER_SAY",
["time"] = 1724506511,
["arg1"] = "Ce n’est pas comme si je pouvais les mettre dans un vase, mais j’apprécie l’intention.",
},
{
["arg2"] = "Taenar Robustoth",
["type"] = "MONSTER_SAY",
["time"] = 1724506519,
["arg1"] = "Aemyra, Orren est gentil, mais un peu étrange. Que lui trouvez-vous ?",
},
{
["arg2"] = "Aemyra Acton",
["type"] = "MONSTER_SAY",
["time"] = 1724506522,
["arg1"] = "Tant de choses, Taenar ! La façon dont il envisage d’aider les habitants de Sainte-Chute ne manque pas d’ambition. J’admire cela.",
},
{
["arg2"] = "Aemyra Acton",
["type"] = "MONSTER_SAY",
["time"] = 1724506529,
["arg1"] = "Il fait preuve d’une grande persévérance, même lorsque la situation se corse. Et il travaille sur MARIE depuis deux ans !",
},
{
["arg2"] = "Aemyra Acton",
["type"] = "MONSTER_SAY",
["time"] = 1724506534,
["arg1"] = "Et tout le monde n’est pas de taille à supporter une falotière qui est toujours prête à prendre des risques et à aider son prochain. Mais Orren, si.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724506541,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506590,
["arg1"] = "C’est terrible. Comment vais-je l’arrêter ?",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506599,
["arg1"] = "Faites ce que vous avez à faire, Kronf. En revanche, s’il est possible de ne pas la détruire complètement, je vous en serais reconnaissant.",
},
{
["arg2"] = "MARIE",
["type"] = "MONSTER_SAY",
["time"] = 1724506608,
["arg1"] = "Menace contre le rendement des cultures détectée. Éradication.",
},
{
["arg2"] = "MARIE",
["type"] = "MONSTER_SAY",
["time"] = 1724506634,
["arg1"] = "Dégâts subis supérieurs aux paramètres de conception. Retour pour tests de diagnostic.",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506662,
["arg1"] = "Merci d’avoir arrêté MARIE, Kronf. Je ne suis pas sûr de pouvoir un jour la faire fonctionner correctement.",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506666,
["arg1"] = "Merci d’avoir apporté cette information, Kronf. C’est un plaisir de l’entendre.",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506669,
["arg1"] = "Merci, je n’avais pas la tête à ça, tout à l’heure. Mais je suis prêt à me remettre au travail.",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506675,
["arg1"] = "Ouah, elle a dit que j’étais un génie ? Ce genre de choses me permet d’allumer ma propre lampe, si vous me permettez l’expression.",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506676,
["arg1"] = "Aemyra dit qu’elle a hâte de me voir. J’aimerais bien que ce soit plus tôt, mais j’attendrai, Kronf !",
},
{
["arg2"] = "Orren Maçyn",
["type"] = "MONSTER_SAY",
["time"] = 1724506677,
["arg1"] = "Je serai dans la remise, avec ce qu’il reste de MARIE. Je touche vraiment au but, malgré cet énorme contretemps.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724506713,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724506797,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724506892,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Tefferty Ulreth",
["type"] = "MONSTER_SAY",
["time"] = 1724506910,
["arg1"] = "Voilà les dernières fleurs de m’dame Gail. Vous êtes sûr que ça va marcher, Wenren ? C’est tout ce qui lui restait de chez elle.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506916,
["arg1"] = "Merci, Teff. Je sais. Je regrette. Dis-lui que je regrette. Ça va marcher.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506928,
["arg1"] = "Allez, on commence ! Branchez les modules sur les sorts, ma nouvelle assistante, pendant que je prépare la séquence d’alimentation énergétique.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506946,
["arg1"] = "Tous les êtres vivants contiennent un souvenir profond de l’endroit où ils sont nés. J’ai travaillé pendant des années pour pouvoir exploiter ces informations.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506954,
["arg1"] = "Et maintenant, je peux utiliser l’énergie de ces crabes pour catalyser une combinaison de sorts de téléportation ! Nous allons tester cette théorie sur des plantes.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506964,
["arg1"] = "Là ! Un portail ! Il devrait nous emmener là où cette plante a poussé. J’ai marqué l’endroit où je l’avais cueillie, alors… on va bien voir !",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506976,
["arg1"] = "Euh ? Ça ne risque rien ? Vous êtes en vie ? Oh, j’espère que ce n’était pas un aller simple vers la mort. Vous pourriez me faire signe ?",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506986,
["arg1"] = "C’est… c’est là ! Oui ! C’est l’endroit où j’ai cueilli la fleur qu’on vient de tester !",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724506991,
["arg1"] = "Ça a fonctionné ! On est bien à l’endroit où pousse la fleur ! On… on doit le confirmer ! J’ai une autre plante. Recommençons !",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724507005,
["arg1"] = "Tout va bien ? Pas de monstre effrayant dans les parages ?",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_EMOTE",
["time"] = 1724507010,
["arg1"] = "Wenren essuie ses larmes.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724507011,
["arg1"] = "Je n’en reviens pas, j’ai réussi ! Oui ! Je vais pouvoir ramener mon peuple à la maison !",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724507016,
["arg1"] = "Vous pensez que Larky est encore à la maison ? C’est… c’est mon chat.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724507019,
["arg1"] = "Retrouvez-moi à mon labo, Kronf. Ensemble, nous allons achever le véritable sort pour tous nous ramener dans l’empire.",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
["time"] = 1724507026,
["arg1"] = "Euh, pardon, est-ce que je viens de lancer téléportation au lieu de portail… ?",
},
{
["arg2"] = "Ravageant",
["type"] = "MONSTER_EMOTE",
["time"] = 1724507027,
["arg1"] = "Le sol de la terre du Crépuscule tremble violemment… Quelque chose s’agite sous la surface !",
},
{
["arg2"] = "Tefferty Ulreth",
["type"] = "MONSTER_SAY",
["time"] = 1724507234,
["arg1"] = "Vous avez suivi ma piste, hein ? Ce sera votre dernière erreur !",
},
{
["arg2"] = "Tefferty Ulreth",
["type"] = "MONSTER_SAY",
["time"] = 1724507249,
["arg1"] = "L’Ordre de la nuit… l’emportera…",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724507265,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724507280,
["arg1"] = "Oh, Wenren… Ce que je peux être bête. On aurait dû avoir foi en toi. On aurait dû t’offrir une protection digne de ta cause.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724507287,
["arg1"] = "… La cruauté de l’Ordre de la nuit est indescriptible. Combien d’autres se cachent parmi nous ? Il va nous falloir redoubler de prudence.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724507293,
["arg1"] = "Merci pour votre aide, Kronf. Je regrette cette tragédie. Je veillerai à ce qu’on rende hommage à Wenren.",
},
{
["arg2"] = "Brann Barbe-de-Bronze",
["type"] = "MONSTER_SAY",
["time"] = 1724507334,
["arg1"] = "On a atterri dans un sacré bazar.",
},
{
["arg2"] = "Brann Barbe-de-Bronze",
["type"] = "MONSTER_SAY",
["time"] = 1724507349,
["arg1"] = "Pas b’soin d’attendre Xal’atath pour passer à l’action, non ? Faites-moi signe quand vous s’rez disposée à vous mettre au travail.",
},
{
