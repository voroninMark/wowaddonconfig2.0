["arg1"] = "Je n’en ai connu aucun, mais je suis sûr qu’ils étaient tous deux formidables.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_EMOTE",
["time"] = 1724604916,
["arg1"] = "Faerin adresse un sourire au Gobelin et à toutes les personnes présentes.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724604921,
["arg1"] = "Sire Cendréaume a donné sa vie pour Sainte-Chute. Ryton était mon mentor et mon ami le plus cher. Nous leur rendons hommage aujourd’hui en remettant à la Flamme leurs possessions les plus chères.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724604945,
["arg1"] = "L’expédition a conçu le prieuré comme un lieu de contemplation des mystères de Beledar.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724604959,
["arg1"] = "Les gardes voulaient vous tuer ? Le capitaine Dailcri a quelque chose à cacher.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724604966,
["arg1"] = "Ses lieutenants renforcent sa tactique. Attirez-les au loin et terrassez-les.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724605061,
["arg1"] = "Dailcri était un héros arathi. Comment le prieuré l’a-t-il contraint à se retourner contre Sainte-Chute ?",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_SAY",
