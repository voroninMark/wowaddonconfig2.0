["clColor"] = "fff48cba",
},
{
["arg2"] = "Дредноу-Дракономор",
["type"] = "SAY",
["time"] = 1716366736,
["arg1"] = "Луч жестокой боли",
["clColor"] = "ffffffff",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716366745,
["arg1"] = "Enfin, son emprise se relâche.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716366749,
["arg1"] = "Sarkareth aurait donc le pouvoir de lacérer nos esprits ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366753,
["arg1"] = "Le traître n’en est pas capable, mon fils. De terribles forces s’éveillent… Elles sentent votre présence.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716366761,
["arg1"] = "Père ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366763,
["arg1"] = "Je ne suis qu’un écho. Je ne peux empêcher que des intrus tentent de piller mes secrets.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366768,
["arg1"] = "Mes héritiers sont là ; nous pouvons empêcher que quiconque s’approprie ce qui nous revient de droit.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366778,
["arg1"] = "J’imagine que vous avez beaucoup entendu parler de cet endroit et de son rôle dans ma chute.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366784,
["arg1"] = "Que cela n’influe cependant pas sur votre perception.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366788,
["arg1"] = "Ces murs sont les vôtres. C’est votre héritage et ces misérables ne doivent pas vous en priver.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716366794,
["arg1"] = "Sécurisez le périmètre !",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716366796,
["arg1"] = "Irion, je vais entrer dans l’enceinte avec un contingent et déloger Sarkareth. Passe de l’autre côté et vois ce que tu peux trouver.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366803,
["arg1"] = "Un plan avisé. Je vais vous accompagner tous les deux pour vous aider.",
},
{
["arg2"] = "Ogidrakona-Kazzak",
["type"] = "SAY",
["time"] = 1716366820,
["arg1"] = "Dream Burst on Ogidrakona",
["clColor"] = "ff33937f",
},
