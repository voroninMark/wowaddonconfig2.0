},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716369218,
["arg1"] = "Bravo, le conduit va rester inerte…",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716369221,
["arg1"] = "… mais nous devrons bientôt le réactiver. Tu trouveras peut-être des Djaradins en meilleure forme à l’extérieur.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716369229,
["arg1"] = "Tu voudrais que je… Non.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716369232,
["arg1"] = "J’attendais mieux de toi, Sabellian. Mais qu’importe. Irion aura peut-être la détermination nécessaire.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716369242,
["arg1"] = "Le creuset attend ! Il est temps d’arrêter Sarkareth.",
},
{
["arg2"] = "Dragondaddy",
["type"] = "MONSTER_EMOTE",
["time"] = 1716369315,
["arg1"] = "Le jeune Dragonnet rubis |2 Dragondaddy rote et esquisse un sourire tandis que de la fumée s’échappe de ses naseaux.",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716369542,
["arg1"] = "Ce geignard ne nous importunera plus. Je vais pouvoir vous aider…",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716369547,
["arg1"] = "… au moins à faire disparaître cette lave et dégager la voie menant à Sarkareth.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716369553,
["arg1"] = "Irion, je commence à me demander si nous ne ferions pas fausse route.",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716369557,
["arg1"] = "Moi aussi. Mais nous devons arrêter Sarkareth. Reste sur tes gardes.",
},
{
