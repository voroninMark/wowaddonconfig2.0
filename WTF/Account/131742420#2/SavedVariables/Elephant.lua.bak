{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490586,
["arg1"] = "Voilà pourquoi pas creuser trop fort ou trop haut, les petits. Sinon paf, comme Mâchouar !",
