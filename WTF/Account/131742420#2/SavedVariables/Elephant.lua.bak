{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490767,
["arg1"] = "WOUSH ! Mipsy failli perdre sa tête ! Taupe affamée voulait pas être amie.",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490770,
["arg1"] = "Mais Mipsy pas abandonner. Peut-être taupe a juste besoin manger pour se calmer ?",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490778,
["arg1"] = "Ça marcher ! Taupe laisser Mipsy monter. Taupe courir ! Taupe s’agiter !",
