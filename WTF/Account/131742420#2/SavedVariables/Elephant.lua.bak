["arg1"] = "L’ennemi a pénétré sur les terrains d’entraînement !",
},
{
["arg2"] = "Capitaine Dailcri",
["type"] = "MONSTER_YELL",
["time"] = 1724605004,
["arg1"] = "Maÿ, votre terrain d’entraînement tombe aux mains des intrus !",
},
{
["arg2"] = "Capitaine Dailcri",
["type"] = "MONSTER_YELL",
["time"] = 1724605026,
["arg1"] = "La véritable voie du peuple arathi est la nôtre !",
},
{
["arg2"] = "Capitaine Dailcri",
["type"] = "MONSTER_YELL",
["time"] = 1724605039,
["arg1"] = "Montrez-leur la puissance de la flamme !",
},
{
["arg2"] = "Capitaine Dailcri",
["type"] = "MONSTER_YELL",
["time"] = 1724605041,
["arg1"] = "Par la griffe et le croc !",
},
{
["arg2"] = "Capitaine Dailcri",
["type"] = "MONSTER_YELL",
["time"] = 1724605041,
["arg1"] = "Finissez-en avec ces impies !",
},
{
["arg2"] = "Capitaine Dailcri",
["type"] = "MONSTER_YELL",
["time"] = 1724605052,
["arg1"] = "Je me retire… dans la gloire…",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605065,
["arg1"] = "Les sbires de Heurtacier ? Gardes ! Gardes !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605115,
["arg1"] = "Non, ils servent cette vieille sotte de sœur Blayze. Détruisez ces étrangers !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724605125,
["arg1"] = "Tiens, tiens, qui voilà ? Des indésirables !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724605134,
["arg1"] = "Par mon marteau sacré !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724605138,
["arg1"] = "Ma première… défaite…",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605166,
["arg1"] = "Beledar est le creuset. Il consume les faiblesses. Sa lumière aveuglante révèle à nous autres du peuple arathi la force qui nous manquait.",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605175,
["arg1"] = "Avec une armée de ressuscités, le peuple arathi vaincra les Nérubiens, conquerra Khaz Algar et soumettra le monde !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605191,
["arg1"] = "Personne parmi le peuple arathi ne cesse de servir l’empereur. Même dans la mort !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605208,
["arg1"] = "La Flamme sacrée purifiera vos crimes !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605215,
["arg1"] = "Les flammes vous emportent !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605220,
["arg1"] = "Par le feu purificateur !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605224,
["arg1"] = "Mes frères et sœurs ! Accueillez la flamme !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724605240,
["arg1"] = "L’Empire sera témoin… vous brûlerez…",
},
{
["arg2"] = "Avanoxx",
["type"] = "RAID_BOSS_EMOTE",
["time"] = 1724605415,
["arg1"] = "Sa voix perçante s’éteint… Le fredonnement des autres auxiliaires s’intensifie.",
},
{
["arg2"] = "Avanoxx",
["type"] = "RAID_BOSS_EMOTE",
["time"] = 1724605443,
["arg1"] = "Une voix perçante résonne encore… Les toiles commencent à vibrer…",
},
{
["arg2"] = "Avanoxx",
["type"] = "RAID_BOSS_EMOTE",
["time"] = 1724605479,
["arg1"] = "Les voix des auxiliaires ont été réduites au silence… Quelque chose apparaît !",
},
{
["arg2"] = "Anub'zekt",
["type"] = "MONSTER_YELL",
["time"] = 1724605545,
["arg1"] = "Des intrus ! Trouvez-les !",
},
{
["arg2"] = "Anub'zekt",
["type"] = "MONSTER_YELL",
["time"] = 1724605641,
["arg1"] = "Quelle incompétence. Je vous tuerai moi-même !",
},
{
["arg2"] = "Anub'zekt",
["type"] = "MONSTER_YELL",
["time"] = 1724605657,
["arg1"] = "Mon essaim vous détruira.",
},
{
["arg2"] = "Anub'zekt",
["type"] = "MONSTER_YELL",
["time"] = 1724605676,
["arg1"] = "Ma garde… prend fin…",
},
{
["arg2"] = "Ki'katal la Moissonneuse",
["type"] = "MONSTER_YELL",
["time"] = 1724605699,
["arg1"] = "Autrefois, mon peuple prospérait sous le commandement de l’Empire noir.",
},
{
["arg2"] = "Ki'katal la Moissonneuse",
["type"] = "MONSTER_YELL",
["time"] = 1724605706,
["arg1"] = "La reine Neferess refusait cette gloire. Mais c’en est assez.",
},
{
["arg2"] = "Ki'katal la Moissonneuse",
["type"] = "MONSTER_YELL",
["time"] = 1724605713,
["arg1"] = "Ansurek et le Sang noir annoncent une nouvelle ère pour Azj-Kahet !",
},
{
["arg2"] = "Ki'katal la Moissonneuse",
["type"] = "MONSTER_YELL",
["time"] = 1724605760,
["arg1"] = "La moisson triomphera !",
},
{
["arg2"] = "Ki'katal la Moissonneuse",
["type"] = "MONSTER_YELL",
["time"] = 1724605788,
["arg1"] = "Que le Vide vous emporte !",
},
{
["arg2"] = "Ki'katal la Moissonneuse",
["type"] = "MONSTER_YELL",
["time"] = 1724605790,
["arg1"] = "Mon sang… pleure…",
},
