{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_YELL",
["time"] = 1715507166,
["arg1"] = "À la charge, braves enfants de Teera !",
},
{
["arg2"] = "Khan Balakar",
["type"] = "MONSTER_YELL",
