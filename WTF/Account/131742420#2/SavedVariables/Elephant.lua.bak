{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490808,
["arg1"] = "Et comme ça Kobolds apprendre à chevaucher taupe. Et à emporter nourriture, au cas où.",
