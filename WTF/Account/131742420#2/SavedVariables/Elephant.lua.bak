{
["arg2"] = "Thrall",
["type"] = "MONSTER_SAY",
["time"] = 1724435363,
["arg1"] = "Une vision est apparue à travers Azeroth. Un chant radieux. Nous pensons qu’il s’agit d’un avertissement, mais nous ignorons sa signification.",
},
{
["arg2"] = "Thrall",
["type"] = "MONSTER_SAY",
["time"] = 1724435372,
["arg1"] = "Retrouvez-moi à Silithus. Nous devons demander à l’orateur d’Azeroth ce que signifie cette vision.",
},
{
["arg2"] = "Hâbleur",
["type"] = "MONSTER_SAY",
["time"] = 1724435390,
["arg1"] = "Les parias d’obsidienne vont reprendre le donjon du Fléau-des-Dragons d’ici dix minutes ! Nous avons besoin de vous ; venez, je vous dirai quoi faire !",
