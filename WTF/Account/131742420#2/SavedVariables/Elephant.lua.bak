["arg1"] = "Fabuleux, un de placé ! Le prochain endroit se trouve dans le désert Grondant.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724436946,
["arg1"] = "L’expédition a conçu le prieuré comme un lieu de contemplation des mystères de Beledar.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724436961,
["arg1"] = "Les gardes voulaient vous tuer ? Le capitaine Dailcri a quelque chose à cacher.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724436968,
["arg1"] = "Ses lieutenants renforcent sa tactique. Attirez-les au loin et terrassez-les.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437138,
["arg1"] = "Plus possible de faire marche arrière. Vous allez devoir combattre Dailcri.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437182,
["arg1"] = "Dailcri était un héros arathi. Comment le prieuré l’a-t-il contraint à se retourner contre Sainte-Chute ?",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_SAY",
["time"] = 1724437234,
["arg1"] = "Leur mission est remplie. Baron, montrez votre valeur.",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724437240,
["arg1"] = "Quiconque s’oppose à l’empereur mordra la poussière !",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437275,
["arg1"] = "Murrpray a changé le prieuré. D’un lieu de contemplation, elle en a fait le théâtre d’un soulèvement. Pourquoi ?",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437285,
["arg1"] = "Elle a toujours prôné la volonté de l’empereur. Mais se retourner contre nous est une folie.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437327,
["arg1"] = "Quelle hérésie ! Ils souillent la Flamme sacrée en dirigeant les morts. Ils ne valent pas mieux que les Kobyss !",
},
{
["arg2"] = "Kronf-Archimonde",
["type"] = "SAY",
["time"] = 1724437374,
["arg1"] = "Purification sur Kronf",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437407,
["arg1"] = "C’est fait. Ces zélotes n’orientent plus notre foi vers la destruction.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724437416,
["arg1"] = "Que celles et ceux qui trouvent du réconfort dans la lumière de la Flamme sacrée soient remerciés.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437435,
["arg1"] = "Nous y voilà. Le haut-mandataire Eirich… ou est-ce juste Eirich maintenant ?",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437442,
["arg1"] = "Il s’est enfui de la Salle de l’Éveil pour se réfugier dans la Cavepierre.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437445,
["arg1"] = "Il fuit sans doute comme une petite souris. Une petite bête efflanquée, recroquevillée et craintive !",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437468,
["arg1"] = "Qu’est-ce que c’est ? Ce golem a fusionné avec quelque chose d’autre ?",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437473,
["arg1"] = "Une technologie terrestre enrichie d’adjuvants magiques… Génial !",
},
{
["arg2"] = "Idontknowbro-Archimonde",
["type"] = "SAY",
["time"] = 1724437494,
["arg1"] = "Rayon sur Idontknowbro",
["clColor"] = "ffc41e3a",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437511,
["arg1"] = "La porte principale semble verrouillée. L’un ou l’autre de ces chemins devrait nous mener à une console.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437578,
["arg1"] = "Des mandataires des machines ! Dans la Cavepierre ! D’une fidélité inconditionnelle.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437615,
["arg1"] = "Cherchez un autre chariot de mine. S’il y en a un, autant l’utiliser.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437620,
["arg1"] = "À moins que vous ne préfériez marcher…",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437694,
["arg1"] = "Un golem mêlé à la corruption skardyn ? Fascinant !",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437740,
["arg1"] = "Cherchez un tunnel à proximité. Vous devriez pouvoir utiliser un chariot de mine pour retourner au Traitement central.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437756,
["arg1"] = "Le voilà. Regardez-le. On ne peut plus rien pour lui.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724437761,
["arg1"] = "On dirait une sorte de justice immanente, mais… finissons-en.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724437891,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724437999,
["arg1"] = "Simple comme bonjour ! Plus qu’un. Il risque d’être… un peu plus dangereux. C’est dans Taelloch.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438004,
["arg1"] = "Je sais, je sais. C’est dangereux et infesté de Skardyns, mais il y a une grande concentration de brume ! On ne peut s’en passer.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438040,
["arg1"] = "Bon, d’accord, c’est pire que des lucioles, mais ça reste à votre portée, non ?",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438106,
["arg1"] = "Nous avons tous les échantillons ! C’était du gâteau ! Du moins, pour moi, haha. Désolée. Vous pouvez revenir.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724438313,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438416,
["arg1"] = "Bien ! Utilisez le traqueur de brume pour révéler les résidus laissés par les bêtes de brume.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438420,
["arg1"] = "Oh ! Juste sous mon nez ! Il ne nous reste qu’à suivre la piste. Continuez à utiliser le traqueur de brume pour en révéler davantage.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438451,
["arg1"] = "Je pensais que les bêtes de brume vous attaqueraient, mais non.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438456,
["arg1"] = "J’avais le pressentiment que leur réputation n’était qu’une histoire de corrélation.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724438474,
["arg1"] = "Hmm. On dirait que les traces s’arrêtent au bord de l’eau. J’imagine que les résidus auront été emportés. Peut-être devrions-nous inspecter l’autre côté de la rivière ?",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724439086,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439199,
["arg1"] = "Regardez ! La bête a traversé le ravin et a tourné par ici. Il va falloir voler pour la suivre. En avant !",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439241,
["arg1"] = "Les voilà ! Je n’en avais jamais vu autant au même endroit ! Ce doit être leur nid, mais comment font-elles pour voyager d’ici au reste des profondeurs ?",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439251,
["arg1"] = "Vite, Kronf. Pas de bruit ! Nous devons prendre une photo.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439257,
["arg1"] = "Oh, non ! J’ai oublié que le flash était activé !",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439262,
["arg1"] = "Pitié, nous venons en paix ! Ne nous faites pas de mal !",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439275,
["arg1"] = "Aaaaaaaaaaaahhhhhh !",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439281,
["arg1"] = "… Hm.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439283,
["arg1"] = "Nous sommes… hors du camp Murroch. Elles auraient pu nous tuer, mais elles ne l’ont pas fait.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724439443,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Clive DelGlingo",
["type"] = "MONSTER_SAY",
["time"] = 1724439455,
["arg1"] = "Et alors ? Vous allez les faire sauter ?",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724439458,
["arg1"] = "Non, seulement l’effrayer. Ce serait irrationnel de faire du mal à une bête de brume.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439467,
["arg1"] = "Vous savez, j’ai réfléchi…",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439468,
["arg1"] = "C’est vraiment dommage que nous n’ayons pas réussi à découvrir d’où viennent les bêtes de brume. Vous ne trouvez pas, Kronf ?",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724439474,
["arg1"] = "J’imagine qu’il va falloir apprendre à vivre avec elles.",
},
{
["arg2"] = "Soldat terrestre",
["type"] = "MONSTER_SAY",
["time"] = 1724439787,
["arg1"] = "Merci de m’avoir sauvé la vie, championne !",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440113,
["arg1"] = "Alors, marchand, que savez-vous ?",
},
{
["arg2"] = "Clive DelGlingo",
["type"] = "MONSTER_SAY",
["time"] = 1724440115,
["arg1"] = "Oui, Arbauch est passé par ici. Il avait l’air très nerveux.",
},
{
["arg2"] = "Clive DelGlingo",
["type"] = "MONSTER_SAY",
["time"] = 1724440120,
["arg1"] = "Il a parlé d’une station relais sous Murroch. Je n’ai rien compris.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440121,
["arg1"] = "Il serait avisé de faire au plus vite.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440224,
["arg1"] = "Arbauch a dû lancer cette protection de l’intérieur…",
},
{
["arg2"] = "Contremaître Arbauch",
["type"] = "MONSTER_SAY",
["time"] = 1724440245,
["arg1"] = "Danagh. Pardon d’être parti. Je pensais pouvoir… je ne sais pas.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440246,
["arg1"] = "Za rakkan alar rukadare amanare enkil zekul. Za kiel, rikk kirasath, tor kielda pathrebosh ul daz zekul revos.",
},
{
["arg2"] = "Contremaître Arbauch",
["type"] = "MONSTER_SAY",
["time"] = 1724440250,
["arg1"] = "Il était confus… et il m’a blessé. Je me sens très immobile. Que les Titans me pardonnent.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440251,
["arg1"] = "Si le golem a corrompu ce terminal, ça pourrait être dangereux. Dites-moi quand vous voulez y aller.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440269,
["arg1"] = "Préparez-vous, les machines sont sensibles. Dans les profondeurs, elles ne font pas que se détériorer, elles se corrompent.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440286,
["arg1"] = "Purge de la mémoire tampon.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440305,
["arg1"] = "Reconstruction des secteurs défectueux.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440338,
["arg1"] = "Non ! C’est trop tard. Je ne peux pas…",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440344,
["arg1"] = "Il est irréparable. Je dois réfléchir. Retrouvez-moi au camp Murroch. Je ne laisserai pas tomber Arbauch une deuxième fois.",
},
{
["arg2"] = "Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440359,
["arg1"] = "Commencez les réparations. Nous devons retrouver le golem.",
},
{
["arg2"] = "Clive DelGlingo",
["type"] = "MONSTER_SAY",
["time"] = 1724440363,
["arg1"] = "Je dois pouvoir vous aider",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724440395,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Marche-rouage de Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440555,
["arg1"] = "Quelle indignité. Nous avons négligé ces machines.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1724440639,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Marche-rouage de Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440680,
["arg1"] = "Faites que je reste près de l’appareil pendant qu’il fonctionne.",
},
{
["arg2"] = "Marche-rouage de Danagh",
["type"] = "MONSTER_SAY",
["time"] = 1724440695,
["arg1"] = "Lieu analysé.",
},
{
["arg2"] = "Soeur Etna Blayze",
