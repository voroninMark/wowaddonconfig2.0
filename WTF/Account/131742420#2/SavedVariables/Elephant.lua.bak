{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490808,
["arg1"] = "Vous écouter ou pas ? Histoire pas se passer comme ça ! On reprend !",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490828,
["arg1"] = "Au début, Kobolds pas connaître « surface ». Notre monde être seulement caverne, tunnel, mine.",
