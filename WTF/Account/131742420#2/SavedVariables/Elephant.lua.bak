},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978505,
["arg1"] = "À nous la gloire !",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978510,
["arg1"] = "C’est votre dernière chance, espèces de crustacés d’eau douce à langue fourchue !",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978513,
["arg1"] = "Vous n’avez pas à rentrer chez vous, mais vous ne pouvez pas rester ici.",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978531,
["arg1"] = "Restez sur vos gardes !",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978544,
["arg1"] = "Restez sur vos gardes !",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978552,
["arg1"] = "Vous avez réussi ! Le refuge Patte-du-Tonnerre est sauvé !",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978557,
["arg1"] = "J’ai justement la bière parfaite pour ce genre de célébration. La première tournée est pour moi. Merci, les amis !",
},
{
["arg2"] = "Crâne parlant",
["type"] = "MONSTER_SAY",
["time"] = 1715978674,
["arg1"] = "Nous y voilà. Essayez donc de rester en vie jusqu’au bout.",
},
{
["arg2"] = "Crâne parlant",
["type"] = "MONSTER_EMOTE",
["time"] = 1715978760,
["arg1"] = "Le crâne parlant ricane joyeusement de voir l’âme de l’instructrice anéantie.",
},
{
["arg2"] = "Crâne parlant",
["type"] = "MONSTER_EMOTE",
["time"] = 1715978780,
["arg1"] = "Le crâne parlant semble hésiter à pénétrer dans la pièce, mais finit par vous suivre.",
},
{
["arg2"] = "Crâne parlant",
["type"] = "MONSTER_SAY",
["time"] = 1715978846,
["arg1"] = "Je ne peux pas voir ça.",
},
{
["arg2"] = "Crâne parlant",
["type"] = "MONSTER_EMOTE",
["time"] = 1715978885,
["arg1"] = "Le crâne parlant continue vers la salle suivante sans dire un mot.",
},
{
["arg2"] = "Sombre Maître Gandling",
["type"] = "MONSTER_SAY",
["time"] = 1715978895,
["arg1"] = "Très chère, on dirait que nous avons de la visite ! Des amis à vous, Voss ?",
},
{
["arg2"] = "Lilian Voss",
["type"] = "MONSTER_SAY",
["time"] = 1715978903,
["arg1"] = "Vous, là ! Rendez-vous utiles et occupez-vous de ces invocateurs !",
},
{
["arg2"] = "Sombre Maître Gandling",
["type"] = "MONSTER_SAY",
["time"] = 1715978908,
["arg1"] = "Leurs morts ne font que renforcer mes invocateurs ! Regardez !",
},
{
["arg2"] = "Lilian Voss",
["type"] = "MONSTER_SAY",
["time"] = 1715978915,
["arg1"] = "Vous nourrissez leurs frères avec leurs âmes ? Vous êtes complètement malade.",
},
{
["arg2"] = "Sombre Maître Gandling",
["type"] = "MONSTER_SAY",
["time"] = 1715978932,
["arg1"] = "Un souci, Voss ? On fatigue ?",
},
{
["arg2"] = "Lilian Voss",
["type"] = "MONSTER_SAY",
["time"] = 1715978938,
["arg1"] = "Je n’arrêterai jamais de pourchasser les vôtres, nécromancien. JAMAIS.",
},
{
["arg2"] = "Sombre Maître Gandling",
["type"] = "MONSTER_SAY",
["time"] = 1715978939,
["arg1"] = "N’est-ce pas magnifique ? L’entrelac d’os, de chair et d’âme mêlés.",
},
{
["arg2"] = "Lilian Voss",
["type"] = "MONSTER_SAY",
["time"] = 1715978947,
["arg1"] = "Nous verrons bien si la mort vous divertit autant lorsque je vous aurai coupé la gorge !",
},
{
["arg2"] = "Sombre Maître Gandling",
["type"] = "MONSTER_SAY",
["time"] = 1715978948,
["arg1"] = "Vous aussi, vous êtes magnifique, Voss. Vous êtes-vous regardée dans un miroir, récemment ?",
},
{
["arg2"] = "Sombre Maître Gandling",
["type"] = "MONSTER_SAY",
["time"] = 1715978955,
["arg1"] = "Très chère, vous devriez accepter ce don qui vous a été fait.",
},
{
["arg2"] = "Lilian Voss",
["type"] = "MONSTER_SAY",
["time"] = 1715978964,
["arg1"] = "Je ne vous laisserai pas infliger ce cauchemar à une autre âme.",
},
{
["arg2"] = "Lilian Voss",
["type"] = "MONSTER_SAY",
["time"] = 1715978965,
