{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490629,
["arg1"] = "Et PATATRAS ! Tout aller mal tout d’un coup !",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490631,
["arg1"] = "Têtes-de-Caillasse précipiter chez Kobolds ! Tout détruire !",
