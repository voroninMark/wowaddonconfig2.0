["arg1"] = "Vous cherchez la quête ?",
["clColor"] = "ff3fc7eb",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724532453,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Sire Théléon Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532479,
["arg1"] = "Ces Kobyss ont profité de notre combat contre les Nérubiens. Ils sont devenus audacieux, mon frère.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532484,
["arg1"] = "Nous les renverrons dans les profondeurs dépourvues de lumière !",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532497,
["arg1"] = "Votre discipline au combat est impressionnante, mon frère. L’inconnue ferait bien d’en prendre de la graine.",
},
{
["arg2"] = "Sire Théléon Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532503,
["arg1"] = "Excusez Sybaestan, chère amie. Sans votre aide, nous n’en serions pas là.",
},
{
["arg2"] = "Sire Théléon Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532530,
["arg1"] = "Ces escarmouches me fatiguent, mon frère. Si nous ne levons pas le pied, nous risquons de commettre des erreurs.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532535,
["arg1"] = "Nous sommes nourris par la Flamme sacrée, mon frère. Laissons les impies subir la fureur des Kobyss. Nous en profiterons pour les prendre en tenaille.",
},
{
["arg2"] = "Sire Théléon Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532594,
["arg1"] = "Je crains de ne pas être d’aplomb pour affronter un tel nombre d’adversaires, mon frère. Laissez-moi un moment pour me ressaisir.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532601,
["arg1"] = "Si l’inconnue est capable de se battre ainsi, nous devons pouvoir faire de même. L’empereur exige que nous dépassions les limites de nos adversaires.",
},
{
["arg2"] = "Sire Théléon Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532684,
["arg1"] = "Ah ! Frè… re…",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532685,
["arg1"] = "Théléon ! Mon frère, non !",
},
{
["arg2"] = "Sire Théléon Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532686,
["arg1"] = "Toujours… à tes côtés…",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532687,
["arg1"] = "Non ! Ne m’abandonne pas, Théléon !",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724532702,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532781,
["arg1"] = "La préparation de ce vin est une tradition ancestrale ici.",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532783,
["arg1"] = "Écoutez attentivement, je vais vous dire quoi ajouter.",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532786,
["arg1"] = "Ajoutez quelques sachets d’épices spéciales.",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532798,
["arg1"] = "Sautez là-dedans et foulez ce raisin !",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532810,
["arg1"] = "Sautez là-dedans et foulez ce raisin !",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532823,
["arg1"] = "Ajoutez un peu d’herbes sacrées.",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532836,
["arg1"] = "Ajoutez quelques sachets d’épices spéciales.",
},
{
["arg2"] = "Frère Abéalard",
["type"] = "MONSTER_SAY",
["time"] = 1724532848,
["arg1"] = "Ajoutez de l’eau bénite dans le mélange.",
},
{
["arg2"] = "Prieuresse Haelsey Murrpray",
["type"] = "MONSTER_SAY",
["time"] = 1724532966,
["arg1"] = "N’oubliez pas ce que j’ai dit, baron, et conservez la flamme qui anime l’espoir.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724532970,
["arg1"] = "Je… Je garderai votre idée à l’esprit, prieuresse. Je vous remercie.",
},
{
["arg2"] = "Prieuresse Haelsey Murrpray",
["type"] = "MONSTER_SAY",
["time"] = 1724533095,
["arg1"] = "N’oubliez pas ce que j’ai dit, baron, et conservez la flamme qui anime l’espoir.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533099,
["arg1"] = "Je… Je garderai votre idée à l’esprit, prieuresse. Je vous remercie.",
},
{
["arg2"] = "Oit-Archimonde",
["type"] = "SAY",
["time"] = 1724533150,
["arg1"] = "z",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533206,
["arg1"] = "Mon plus vieux souvenir de Théléon… Je me souviens de lui dans son berceau et on m’avait dit de le laisser seul pour qu’il puisse dormir.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533215,
["arg1"] = "Mais je ne voulais pas que mon petit frère se sente seul, alors j’ai mis les petits de notre lynx avec lui.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533222,
["arg1"] = "Ma mère était très contrariée parce que Théléon aurait pu mourir étouffé, mais je ne voulais pas qu’il soit seul… comme il l’est maintenant.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533223,
["arg1"] = "Ma mère était si inquiète de voir Théléon m’accompagner dans l’expédition à Sainte-Chute.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533229,
["arg1"] = "Théléon lui a dit de ne pas s’inquiéter. Que je serais là pour veiller sur lui. Je lui ai garanti que je veillerais toujours sur lui.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533238,
["arg1"] = "J’ai toujours gardé un œil sur lui. Sauf que… Le meilleur de moi-même n’était pas assez bon.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533240,
["arg1"] = "Nous nous sommes parfois disputés. Quels sont les frères qui ne se disputent pas ? Il était beaucoup plus prudent que moi. C’est sur ce point que nous étions le plus en désaccord.",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533251,
["arg1"] = "Mais c’est lui qui avait raison. Je m’en rends compte maintenant. Que vais-je faire sans toi, Théléon ? Comment rester droit ?",
},
{
["arg2"] = "Baron Sybaestan Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724533259,
["arg1"] = "Je suis désolé, Oit. Je pense que j’aimerais être seul pendant un moment.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724533286,
["arg1"] = "Nous ferons toute la lumière sur cette affaire, Oit.",
},
{
["arg2"] = "Moniale vigneronne",
["type"] = "MONSTER_SAY",
["time"] = 1724533309,
["arg1"] = "Nous suivons les ordres de la prieuresse ! Sa volonté ne saurait être remise en question !",
},
{
["arg2"] = "Moniale vigneronne",
["type"] = "MONSTER_SAY",
["time"] = 1724533313,
["arg1"] = "Des cadavres disparus ? Je me demande si la prieuresse est au courant…",
},
{
["arg2"] = "Moniale vigneronne",
["type"] = "MONSTER_SAY",
["time"] = 1724533320,
["arg1"] = "La volonté de la prieuresse sera accomplie !",
},
{
["arg2"] = "Disciple pieux",
["type"] = "MONSTER_SAY",
["time"] = 1724533325,
["arg1"] = "Je ne suis pas au courant. Et la prieuresse ?",
},
{
["arg2"] = "Moniale vigneronne",
["type"] = "MONSTER_SAY",
["time"] = 1724533327,
["arg1"] = "Des cadavres disparus ? Je me demande si la prieuresse est au courant…",
},
{
["arg2"] = "Moine vigneron",
