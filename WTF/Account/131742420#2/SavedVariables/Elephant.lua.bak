["type"] = "MONSTER_SAY",
["time"] = 1724490495,
["arg1"] = "Boum ! Creusé trop haut et trop vite. Toute la caverne s’écrouler sur pauvres Kobolds. Beaucoup piégés. Beaucoup écrabouillés.",
