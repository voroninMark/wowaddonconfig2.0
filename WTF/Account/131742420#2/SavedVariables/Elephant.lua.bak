["type"] = "MONSTER_SAY",
["time"] = 1717181399,
["arg1"] = "Donnez de l’éclat à votre trésor ! Gemmes venues de par-delà les mers taillées à la demande !",
},
{
["arg2"] = "Vekkalis",
["type"] = "MONSTER_SAY",
["time"] = 1717181472,
["arg1"] = "N’est-il pas merveilleux de voir tant d’autres personnes enthousiasmées par la banque ?",
},
{
["arg2"] = "Aéoréon",
["type"] = "MONSTER_EMOTE",
["time"] = 1717181476,
["arg1"] = "Aéoréon soupire.",
},
{
["arg2"] = "Numernormi",
["type"] = "MONSTER_EMOTE",
["time"] = 1717181477,
["arg1"] = "Numernormi rit.",
},
{
["arg2"] = "Aéoréon",
["type"] = "MONSTER_SAY",
["time"] = 1717181478,
["arg1"] = "Tu n’as pas bien compris, Vekkalis.",
},
{
["arg2"] = "Vekkalis",
["type"] = "MONSTER_SAY",
["time"] = 1717181482,
["arg1"] = "Eh bien, c’est absurde. La banque, c’est amusant !",
},
{
["arg2"] = "Compagnon Envial",
["type"] = "MONSTER_SAY",
["time"] = 1717182098,
["arg1"] = "Donnez de l’éclat à votre trésor ! Gemmes venues de par-delà les mers taillées à la demande !",
},
{
["arg2"] = "Recruteuse du Vol draconique de bronze",
["type"] = "MONSTER_SAY",
["time"] = 1717184581,
["arg1"] = "Vous semblez avoir fort à faire, mais si vous m’accordez un petit instant pour vous engager auprès du Vol draconique de bronze, je vous promets que vous ne le regretterez pas !",
},
{
["arg2"] = "Professeure Mystakria",
["type"] = "MONSTER_SAY",
["time"] = 1717184586,
["arg1"] = "De nouvelles recrues ! Merveilleux. Cela faisait un moment que l’académie n’avait pas rouvert ses portes.",
},
{
["arg2"] = "Professeur Ichistrasz",
["type"] = "MONSTER_SAY",
["time"] = 1717184594,
["arg1"] = "En effet ! Suivez-nous ! Il ne faudra que quelques instants pour préparer une nouvelle leçon.",
},
{
["arg2"] = "Professeur Ichistrasz",
["type"] = "MONSTER_SAY",
["time"] = 1717184594,
["arg1"] = "Allons bon. Il semblerait que les lieux soient en moins bon état que nous ne le pensions.",
},
{
["arg2"] = "Professeure Mystakria",
["type"] = "MONSTER_SAY",
["time"] = 1717184599,
["arg1"] = "Ces flagellants ont dû se multiplier en notre absence.",
},
{
["arg2"] = "Professeure Mystakria",
["type"] = "MONSTER_SAY",
["time"] = 1717184603,
["arg1"] = "S’il vous plaît, éliminez-les pendant que nous réalignons la magie de vie qui anime cet endroit.",
},
{
["arg2"] = "Professeure Mystakria",
["type"] = "MONSTER_SAY",
["time"] = 1717184667,
["arg1"] = "Parfait, nous allons… Doucement, Ichistrasz ! La concentration de magie est trop élevée ! Qu’est-ce que vous fabriquez ?",
},
{
["arg2"] = "Professeur Ichistrasz",
["type"] = "MONSTER_SAY",
["time"] = 1717184676,
["arg1"] = "Moi ? Ce sont ces mauvaises herbes qui sont de trop ! Réagissez, bon sang !",
},
{
["arg2"] = "Professeure Mystakria",
["type"] = "MONSTER_SAY",
["time"] = 1717184682,
["arg1"] = "Qu’est-ce que c’est ? Tout ça, c’est votre faute !",
},
{
["arg2"] = "Suskry-Hyjal",
["type"] = "SAY",
["time"] = 1717184685,
["arg1"] = "LOL",
["clColor"] = "ffa330c9",
},
{
["arg2"] = "Professeur Ichistrasz",
["type"] = "MONSTER_SAY",
["time"] = 1717184685,
["arg1"] = "Certainement pas !",
},
{
["arg2"] = "Professeure Mystakria",
["type"] = "MONSTER_SAY",
["time"] = 1717184688,
["arg1"] = "Novices, aidez-nous, s’il vous plaît.",
},
{
["arg2"] = "Malinor",
["type"] = "MONSTER_SAY",
["time"] = 1717184815,
["arg1"] = "Admirez-moi cette arène de Lish Llrath… Hé, mais qu’est-ce que ces oiseaux fichent là ?",
},
{
["arg2"] = "Malinor",
["type"] = "MONSTER_SAY",
["time"] = 1717184919,
["arg1"] = "Faites-les déguerpir ! Ils ont tout abîmé.",
},
{
["arg2"] = "Spell Bunny",
["type"] = "MONSTER_EMOTE",
["time"] = 1717184919,
["arg1"] = "Les aigles pressent leur attaque !",
},
{
["arg2"] = "Suskry-Hyjal",
["type"] = "SAY",
