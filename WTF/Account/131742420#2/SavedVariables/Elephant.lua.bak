{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695778,
["arg1"] = "À tous les citoyens, veuillez rester chez vous et ne pas en sortir.",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695783,
["arg1"] = "Des gardes seront bientôt là pour ramener l’ordre.",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695835,
["arg1"] = "Certes, vous avez neutralisé quelques-unes de mes inventions les plus simples.",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695841,
["arg1"] = "Mais voyons ce que vous valez face à des mécanismes plus complexes.",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695896,
["arg1"] = "Vous possédez donc certaines compétences.",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695900,
["arg1"] = "Mais elles seront insuffisantes face à mon nouveau prototype !",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695963,
["arg1"] = "Électroflux ! Les envahisseurs ont réussi à franchir les défenses extérieures.",
},
{
["arg2"] = "Roi Mécagone",
["type"] = "MONSTER_SAY",
["time"] = 1742695968,
["arg1"] = "Leur présence souille ma ville. Je veux qu’on les élimine !",
},
{
["arg2"] = "Machiniste en chef Electroflux",
["type"] = "MONSTER_SAY",
["time"] = 1742695971,
["arg1"] = "La défense civile a été activée, mon roi.",
},
{
["arg2"] = "Machiniste en chef Electroflux",
["type"] = "MONSTER_SAY",
["time"] = 1742695973,
["arg1"] = "Je vous assure que ces organiques seront purgés de notre métropole.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742695980,
["arg1"] = "Ne vous faites pas détecter par ces robots.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742695983,
["arg1"] = "En restant dans la vapeur, leurs capteurs ne vous détecteront pas.",
},
{
["arg2"] = "Unotre",
