{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724533505,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724533529,
["arg1"] = "Après chaque bataille, je viens aider Kaeleb à l’infirmerie. Il a toujours besoin de bras en plus, et je vois ce que coûte chaque conflit.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724533540,
["arg1"] = "Votre aide nous a déjà été précieuse. Si vous pouviez aider Kaeleb, je vous en serais reconnaissante. Nous payons un lourd tribut aux ténèbres.",
},
{
["arg2"] = "Kaeleb Gardeflamme",
["type"] = "MONSTER_SAY",
["time"] = 1724533548,
["arg1"] = "Il me reste des bandages propres.",
},
{
["arg2"] = "Soldat blessé",
["type"] = "MONSTER_SAY",
["time"] = 1724533550,
["arg1"] = "Je sens mes blessures se refermer. Merci !",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724533551,
["arg1"] = "Nous perdons tant de gens au mur. Mais sans lui, les Nérubiens attaquent les villages.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724533557,
["arg1"] = "Leur stratégie est déconcertante. Leur seul objectif semble être de combattre.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724533563,
["arg1"] = "S’ils ouvrent un nouveau front, je crains que c’en soit fini de nous.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724533569,
["arg1"] = "Je vais me débrouiller, maintenant. Allez donc souffler un peu à l’auberge. Nous avons besoin de toutes vos capacités pour la prochaine crise.",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724533583,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724534157,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Auralia Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724534193,
["arg1"] = "Je prendrai tout ce que vous avez à offrir. Merci, Oit.",
},
{
["arg2"] = "Auralia Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724534211,
["arg1"] = "La générale et moi vous rejoindrons à la Bonté de Dunelle, Oit.",
},
{
["arg2"] = "Auralia Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724534215,
["arg1"] = "Messagère ! Apportez cette lettre aux Terrestres. Que rien ne vous arrête !",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724534221,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534322,
["arg1"] = "L’expédition a conçu le prieuré comme un lieu de contemplation des mystères de Beledar.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534331,
["arg1"] = "Mais depuis peu, ses fidèles agissent en cachette et sont devenus hostiles.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534340,
["arg1"] = "Les gardes voulaient vous tuer ? Le capitaine Dailcri a quelque chose à cacher.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534349,
["arg1"] = "Ses lieutenants renforcent sa tactique. Attirez-les au loin et terrassez-les.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534428,
["arg1"] = "Plus possible de faire marche arrière. Vous allez devoir combattre Dailcri.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534450,
["arg1"] = "Plus possible de faire marche arrière. Vous allez devoir combattre Dailcri.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534489,
["arg1"] = "Dailcri était un héros arathi. Comment le prieuré l’a-t-il contraint à se retourner contre Sainte-Chute ?",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_SAY",
["time"] = 1724534550,
["arg1"] = "Leur mission est remplie. Baron, montrez votre valeur.",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724534556,
["arg1"] = "Quiconque s’oppose à l’empereur mordra la poussière !",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534589,
["arg1"] = "Murrpray a changé le prieuré. D’un lieu de contemplation, elle en a fait le théâtre d’un soulèvement. Pourquoi ?",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534600,
["arg1"] = "Elle a toujours prôné la volonté de l’empereur. Mais se retourner contre nous est une folie.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534646,
["arg1"] = "Quelle hérésie ! Ils souillent la Flamme sacrée en dirigeant les morts. Ils ne valent pas mieux que les Kobyss !",
},
{
["arg2"] = "Mëøwyn-LesSentinelles",
["type"] = "SAY",
["time"] = 1724534691,
["arg1"] = "Purification sur Mëøwyn",
["clColor"] = "ff3fc7eb",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534717,
["arg1"] = "C’est fait. Ces zélotes n’orientent plus notre foi vers la destruction.",
},
{
["arg2"] = "Mëøwyn-LesSentinelles",
["type"] = "EMOTE",
["time"] = 1724534722,
["arg1"] = "{triangle} Zygor Guides: I just leveled up from 79 to 80! (23 minutes)",
["clColor"] = "ff3fc7eb",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724534726,
["arg1"] = "Que celles et ceux qui trouvent du réconfort dans la lumière de la Flamme sacrée soient remerciés.",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724535186,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535203,
["arg1"] = "Oit, pouvez-vous mettre les marchandises en rayon ?",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535208,
["arg1"] = "Merrix, nous avons envoyé des émissaires, mais n’en avons revu aucun. Nous avons-vous offensés ?",
},
{
["arg2"] = "Merrix",
["type"] = "MONSTER_SAY",
["time"] = 1724535214,
["arg1"] = "Vaelisia, je suis navré. Nous n’avons jamais reçu vos émissaires.",
},
{
["arg2"] = "Merrix",
["type"] = "MONSTER_SAY",
["time"] = 1724535218,
["arg1"] = "Après que le monde a tremblé, nous n’avons pas eu de nouvelles de votre peuple. Nous avons craint le pire.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535224,
["arg1"] = "Eh bien, je suis contente que vous soyez en vie. C’est un plaisir de vous revoir, Merrix.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535230,
["arg1"] = "Vous aussi, membres des royaumes étrangers. Bienvenue à Sainte-Chute.",
},
{
["arg2"] = "Auralia Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535234,
["arg1"] = "Voici des exemples d’objets que nous pouvons échanger. J’ai également des listes détaillées.",
},
{
["arg2"] = "Andee Crin-de-Mer",
["type"] = "MONSTER_SAY",
["time"] = 1724535240,
["arg1"] = "Oit vous apporte son aide. C’est sage. Elle a la réputation de résoudre tous les problèmes.",
},
{
["arg2"] = "Andee Crin-de-Mer",
["type"] = "MONSTER_SAY",
["time"] = 1724535253,
["arg1"] = "Hé, si Oit se porte garante, ça me suffit. Faisons affaires !",
},
{
["arg2"] = "Téha",
["type"] = "MONSTER_SAY",
["time"] = 1724535258,
["arg1"] = "Hmm, moi j’apprécie les tarifs avantageux… Le comptoir Zen’Shari aimerait commercer avec le peuple arathi !",
},
{
["arg2"] = "Merrix",
["type"] = "MONSTER_SAY",
["time"] = 1724535262,
["arg1"] = "Nous commercions par le passé, Vaelisia. J’aimerais que nous recommencions.",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724535266,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535266,
["arg1"] = "Je vous remercie. Sauriez-vous pourquoi nos émissaires ne sont pas parvenus à vous joindre ?",
},
{
["arg2"] = "Merrix",
["type"] = "MONSTER_SAY",
["time"] = 1724535272,
["arg1"] = "Les abîmes Retentissants étaient dangereux jusqu’à récemment. Heureusement, Oit a réglé ce problème.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535278,
["arg1"] = "On dirait que je devrais être très redevable envers Oit.",
},
{
["arg2"] = "Générale Heurtacier",
["type"] = "MONSTER_SAY",
["time"] = 1724535282,
["arg1"] = "Auriez-vous un moment ? J’aimerais rattraper le temps. Ça fait si longtemps.",
},
{
["arg2"] = "Merrix",
["type"] = "MONSTER_SAY",
["time"] = 1724535286,
["arg1"] = "Bien sûr. Beaucoup de choses se sont passées. Je vais vous raconter tout ça…",
},
{
["arg2"] = "Wenren Althal",
["type"] = "MONSTER_SAY",
