["time"] = 1687799661,
["arg1"] = "Ouille ! D’accord, d’accord ! Aujourd’hui dans l’arène, un combat sans pareil ! Pour vous, venant des coins les plus reculés du monde, la mystérieuse… la dangereuse… et légèrement négligée… bande de boucaniers puants !",
},
{
["arg2"] = "Spacewølf-Archimonde",
["type"] = "SAY",
["time"] = 1687799674,
["arg1"] = "Jet à ricochets sur Spacewølf",
["clColor"] = "ffc41e3a",
},
{
["arg2"] = "Próvoker-TwistingNether",
["type"] = "SAY",
["time"] = 1687799678,
["arg1"] = "Ricocheting Throw on Próvoker",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Gurgthock",
["type"] = "MONSTER_SAY",
["time"] = 1687799679,
["arg1"] = "Et maintenant dans l’arène, nous avons l’étonnant… le surprenant… le magnifique… le… Hein ? Vous plaisantez ?",
},
{
["arg2"] = "Spacewølf-Archimonde",
["type"] = "SAY",
["time"] = 1687799683,
["arg1"] = "Jet à ricochets sur Spacewølf",
["clColor"] = "ffc41e3a",
},
{
["arg2"] = "Próvoker-TwistingNether",
["type"] = "SAY",
["time"] = 1687799690,
["arg1"] = "Ricocheting Throw on Próvoker",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Gurgthock",
["type"] = "MONSTER_SAY",
["time"] = 1687799690,
["arg1"] = "Un cochon engraissé ? Qu’est-ce que c’est que cette bande d’amateurs ? Très bien… Attrapez le cochon et vous remporterez la victoire.",
},
{
["arg2"] = "Yumihealmoi-Archimonde",
["type"] = "SAY",
["time"] = 1687799705,
["arg1"] = "Jet à ricochets sur Yumihealmoi",
["clColor"] = "ffffffff",
},
{
["arg2"] = "Draconite-DefiasBrotherhood",
["type"] = "SAY",
["time"] = 1687799714,
["arg1"] = "Ricocheting Throw on Draconite",
["clColor"] = "ffc69b6d",
},
{
["arg2"] = "Yumihealmoi-Archimonde",
["type"] = "SAY",
["time"] = 1687799722,
["arg1"] = "Jet à ricochets sur Yumihealmoi",
["clColor"] = "ffffffff",
},
{
["arg2"] = "Gurgthock",
["type"] = "MONSTER_SAY",
["time"] = 1687799752,
["arg1"] = "Eh bien, incroyable. Ils ont attrapé un cochon. On pourrait peut-être passer à un défi un peu plus… difficile !",
},
{
["arg2"] = "Gurgthock",
["type"] = "MONSTER_SAY",
["time"] = 1687799758,
["arg1"] = "Il débarque directement des égouts de Port-Liberté… Celui qu’on surnomme le « puissant protecteur », le « sergent sauvage » ou encore la « carapace coriace » va vous tor… tuer ! Voici Ludwig !",
},
{
["arg2"] = "Gurgthock",
["type"] = "MONSTER_SAY",
["time"] = 1687799826,
["arg1"] = "Ludwig est au tapis ! Quel combat ! Ces boucaniers ont du ressort, et ça vaut mieux pour eux… car leur prochain adversaire est la quintessence de la violence.",
},
{
["arg2"] = "Gurgthock",
["type"] = "MONSTER_SAY",
["time"] = 1687799839,
["arg1"] = "Il garde la pêche en toutes circonstances… Il est le prédateur de Port-Liberté… le champion des compétiteurs… Trothak le cogneur aux requins !",
},
{
["arg2"] = "Yumihealmoi-Archimonde",
