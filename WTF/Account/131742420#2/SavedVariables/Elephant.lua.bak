},
{
["arg2"] = "Brigita",
["type"] = "MONSTER_SAY",
["time"] = 1715603768,
["arg1"] = "Bienvenue au Bélier rôti ! Prenez place.",
},
{
["arg2"] = "Samrájel",
["type"] = "MONSTER_EMOTE",
["time"] = 1715604116,
["arg1"] = "Samrájel prépare un grand banquet des Kalu’aks pour que tout le monde en profite !",
["clColor"] = "ff8788ee",
},
{
["type"] = "TEXT_EMOTE",
["time"] = 1715604158,
["arg1"] = "Samrájel-Silvermoon serre Vilius-Sanguino dans ses bras. Gros câlin !",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604184,
["arg1"] = "Prudence, braves gens. Mon caveau est tout sauf inoffensif.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604189,
["arg1"] = "Toute créature étrangère à ma lignée est perçue comme une menace par ces Dragonnets.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604195,
["arg1"] = "Rien ne leur échappe. S’ils vous voient, les créatures des environs s’éveilleront pour vous chasser.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604374,
["arg1"] = "La Flamme fracturée pille mon caveau en ce moment même.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604378,
["arg1"] = "Ces imbéciles ignorent tout des pouvoirs et des dangers redoutables qui sommeillent en son sein.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604428,
["arg1"] = "Un jour, mon bien-aimé Malygos m’a offert des graines arcaniques que j’ai plantées ici, dans ce petit jardin dédié à sa mémoire.",
},
{
["arg2"] = "Samrájel-Silvermoon",
["type"] = "SAY",
["time"] = 1715604437,
["arg1"] = "Erratic Growth on Samrájel",
["clColor"] = "ff8788ee",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604437,
["arg1"] = "Depuis toutes ces années qu’il est à l’abandon, il est grand temps de… de le tailler.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604571,
["arg1"] = "Aucun signe de la Flamme fracturée pour l’instant. Venez, par ici.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604598,
["arg1"] = "L’emplacement de mon caveau a été choisi afin de pouvoir exploiter cette puissante ligne tellurique.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604604,
["arg1"] = "S’il faut reconnaître que c’est une merveille, j’ignore quels effets elle aura sur vos enveloppes mortelles.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604610,
["arg1"] = "Restez à l’affût d’éventuelles excroissances ou appendices.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604648,
["arg1"] = "Vous avez découvert un de mes livres de transposition.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715604651,
["arg1"] = "La majorité des gardes du caveau étant incapables de voler, j’ai créé ces tomes pour leur fournir un moyen de transport sûr.",
},
{
["arg2"] = "Lame-Azur",
["type"] = "MONSTER_SAY",
["time"] = 1715604874,
["arg1"] = "Oui, oui, quelle beauté. Toute cette… puissance. Rien que pour moi.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605505,
["arg1"] = "Pauvre Lame-Azur. Je ne peux pas lui en vouloir. J’aurais dû penser à elle avant… avant de partir.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605514,
["arg1"] = "Cette porte… Je sens une présence, juste derrière. La Flamme fracturée doit être par là.",
},
{
["arg2"] = "Pillard tarasèke",
["type"] = "MONSTER_SAY",
["time"] = 1715605638,
["arg1"] = "Ces trésors appartiennent à la Flamme fracturée !",
},
{
["arg2"] = "Grazyna-Silvermoon",
