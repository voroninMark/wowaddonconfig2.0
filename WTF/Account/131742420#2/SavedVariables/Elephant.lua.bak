["arg1"] = "Interruption de Aigle alpha |cff71d5ff|Hspell:377389:0|h[Appel de la nuée]|h|r !",
["clColor"] = "ffa330c9",
},
{
["arg2"] = "Malinor",
["type"] = "MONSTER_SAY",
["time"] = 1717184986,
["arg1"] = "Bien. Nous devons à présent éliminer la plus grosse. Je vais activer les buts de Lish Llrath, ou dracoballe pour les peaux tendres. Profitez-en pour attirer son attention.",
},
{
