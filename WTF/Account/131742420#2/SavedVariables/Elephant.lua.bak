},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368040,
["arg1"] = "Un travail exemplaire. Félicitations.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368043,
["arg1"] = "Ce fut un honneur d’évaluer le développement des Dracthyrs de Neltharion.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368047,
["arg1"] = "Ces sujets étaient hélas trop imprévisibles. Mais là où certains voient un échec, je vois une occasion à saisir.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368056,
["arg1"] = "Cette première tentative de Dracthyr donna un sujet bien trop violent pour être contrôlé.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368061,
["arg1"] = "Pourtant, nous avons tout à gagner à documenter ses carnages.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368066,
["arg1"] = "Vous ferez de très bons cobayes.",
},
{
["arg2"] = "Stebamker-Sanguino",
["type"] = "SAY",
["time"] = 1716368169,
["arg1"] = "3",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Stebamker-Sanguino",
["type"] = "SAY",
["time"] = 1716368170,
["arg1"] = "2",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Stebamker-Sanguino",
["type"] = "SAY",
["time"] = 1716368171,
["arg1"] = "1",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368201,
["arg1"] = "Le prototype initial n’avait clairement pas la force désirée. La version suivante fut imprégnée d’une puissance arcanique excessive.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716368259,
["arg1"] = "Une créature aux surcharges arcaniques instables nous était inutile, nous avons donc affiné le processus d’imprégnation.",
},
{
["arg2"] = "Cyrene-Frostmane",
["type"] = "SAY",
["time"] = 1716368276,
