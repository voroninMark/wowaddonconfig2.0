["type"] = "MONSTER_SAY",
["time"] = 1716369933,
["arg1"] = "Impressionnant. Mais il faudra attendre pour savourer cette victoire. Sarkareth nous attend plus bas.",
},
{
["arg2"] = "Bestbounty-TarrenMill",
["type"] = "SAY",
["time"] = 1716369996,
["arg1"] = "Dream Burst on Bestbounty",
["clColor"] = "ffffffff",
},
{
