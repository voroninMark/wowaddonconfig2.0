["arg1"] = " ",
},
{
["arg1"] = "Log commencé pour Atogatog le 05/22/2024 à 10:15:12.",
["type"] = "SYSTEM",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716366336,
["arg1"] = "Tu es acculé, Sarkareth ! Mets un terme à cette folie avant que d’autres ne meurent.",
},
{
["arg2"] = "Squammandant Sarkareth",
["type"] = "MONSTER_SAY",
["time"] = 1716366341,
["arg1"] = "Plutôt mourir que de nous soumettre à nouveau.",
},
{
["arg2"] = "Squammandant Sarkareth",
["type"] = "MONSTER_SAY",
["time"] = 1716366344,
["arg1"] = "Les secrets de ce creuset n’attendent plus que nous ! Avec leur pouvoir, nous serons libres à jamais !",
},
{
["arg2"] = "Altesse-ailée Dezran",
["type"] = "MONSTER_SAY",
["time"] = 1716366366,
["arg1"] = "Nos lignes vont lâcher, Sarkareth ! Nous ne pouvons pas les retenir !",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716366370,
["arg1"] = "Puis-je suggérer une autre stratégie ?",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716366372,
["arg1"] = "À l’époque où je servais Neltharion, je l’ai aidé à créer de nombreux… éléments surpuissants.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716366379,
["arg1"] = "L’un de ces instruments pourrait vous être utile… bien qu’il ne soit pas forcément en mesure de différencier amis et ennemis.",
},
{
["arg2"] = "Squammandant Sarkareth",
["type"] = "MONSTER_SAY",
["time"] = 1716366388,
["arg1"] = "Quel est donc ce pouvoir ?",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716366390,
["arg1"] = "Nous avons fait de nombreux essais pour perfectionner l’armure de Neltharion.",
},
{
["arg2"] = "Zskarn",
["type"] = "MONSTER_SAY",
["time"] = 1716366394,
["arg1"] = "Ceci est l’une de nos tentatives les plus abouties. Malgré ses défauts, ce spécimen devrait suffire à écraser ces indésirables.",
},
{
["arg2"] = "Squammandant Sarkareth",
["type"] = "MONSTER_SAY",
["time"] = 1716366403,
["arg1"] = "Allez-y !",
},
{
["arg2"] = "Altesse-ailée Dezran",
["type"] = "MONSTER_SAY",
["time"] = 1716366404,
["arg1"] = "Mais nos troupes sont encore là-bas !",
},
{
["arg2"] = "Squammandant Sarkareth",
["type"] = "MONSTER_SAY",
["time"] = 1716366406,
["arg1"] = "Leur nom ne tombera pas dans l’oubli.",
},
