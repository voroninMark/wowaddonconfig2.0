["arg1"] = "Peut-être cela pourra-t-il servir…",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978306,
["arg1"] = "Ils sont en train d’escalader les parois de la falaise ! Ça ne va pas être beau à voir.",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978335,
["arg1"] = "Attention où vous mettez les pieds. La pierre est encore glissante à cause de la pluie.",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978352,
["arg1"] = "Ne me faites pas ça !",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978374,
["arg1"] = "Surveillez bien vos arrières. Non - pas MON derrière, derrière nous !",
