{
["arg2"] = "Blackbyrd-Draenor",
["type"] = "SAY",
["time"] = 1716368323,
["arg1"] = "Disintegrate",
["clColor"] = "ff3fc7eb",
},
{
["arg2"] = "Этофокс-Ревущийфьорд",
["type"] = "SAY",
["time"] = 1716368323,
["arg1"] = "Дезинтеграция",
["clColor"] = "ffaad372",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368345,
["arg1"] = "Tes performances dépassent de loin mes attentes.",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716368349,
["arg1"] = "Comment ? Tu savais que ces créatures attendaient d’être libérées ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368352,
["arg1"] = "Bien sûr ! Et tu t’es montré à la hauteur du défi, comme je l’avais prédit.",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716368357,
["arg1"] = "Voilà qui me semble… douteux. Cette vision, à quel point est-elle flexible ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368422,
["arg1"] = "Sabellian, tu es mon sang, et en tant que tel, mon héritier. Mais n’oublie jamais que l’on cherchera à te voler ce legs.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368432,
["arg1"] = "En ce moment même, des armées djaradines profitent du chaos pour attaquer. Il faut les arrêter.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716368439,
["arg1"] = "Je ne céderai pas un pouce de terrain.",
},
{
["arg2"] = "Cyrene-Frostmane",
["type"] = "SAY",
["time"] = 1716368840,
["arg1"] = "Blazing Spear on Cyrene",
["clColor"] = "ff8788ee",
},
{
["arg2"] = "Jøhneagles-Archimonde",
["type"] = "SAY",
["time"] = 1716368840,
["arg1"] = "Lance embrasée",
["clColor"] = "ffaad372",
},
{
["arg2"] = "Этофокс-Ревущийфьорд",
["type"] = "SAY",
["time"] = 1716368840,
["arg1"] = "Пылающее копье",
["clColor"] = "ffaad372",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716368884,
["arg1"] = "Leurs troupes sont en déroute ! Nous avons gagné !",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368887,
["arg1"] = "Une belle victoire, mon fils. Je n’en attendais pas moins.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368891,
["arg1"] = "Pourtant, le creuset n’est pas hors de danger. Un dernier obstacle se dresse sur ton chemin.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716368897,
["arg1"] = "Dis-moi lequel, et je le balaierai.",
},
{
["arg2"] = "Rashok",
["type"] = "MONSTER_SAY",
["time"] = 1716368912,
["arg1"] = "Enfin libre !",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716368915,
["arg1"] = "Comment cet ancien a-t-il franchi nos lignes ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368918,
["arg1"] = "Cette créature n’a pas participé à l’attaque. C’est elle que l’adversaire espérait libérer.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368924,
["arg1"] = "Des millénaires durant, elle a servi à alimenter le creuset.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716368929,
["arg1"] = "Tu ponctionnais la force de ce Djaradin pour tes expériences ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716368933,
["arg1"] = "Dommage qu’il faille l’éliminer avant que les conduits n’entrent en surcharge et nous anéantissent.",
