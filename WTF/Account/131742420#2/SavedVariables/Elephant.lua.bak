{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724436105,
["arg1"] = "Voilà trois dispositifs de récupération de la brume. Quand vous aurez atteint les endroits que j’ai indiqués sur votre carte, placez un dispositif.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724436114,
["arg1"] = "Attendez alors qu’il se remplisse de brume ! Et si une de ces bêtes vous attaque, eh bien… vous devrez vous défendre.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724436134,
["arg1"] = "Parfait, c’est le bon endroit ! Maintenez, placez le récupérateur de brume et laissez-le faire son travail, mais ne vous éloignez pas ! Il faut le garder sous surveillance.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724436176,
["arg1"] = "Hm. Je m’attendais à ce que cela énerve les bêtes de brume, mais pas à ce que ça attire des mites luisantes.",
},
{
["arg2"] = "Noli Marlen",
["type"] = "MONSTER_SAY",
["time"] = 1724436208,
["arg1"] = "Fabuleux, un de placé ! Le prochain endroit se trouve dans le désert Grondant.",
},
{
