{
["arg2"] = "Proviseur Fynch",
["type"] = "MONSTER_SAY",
["time"] = 1724506248,
["arg1"] = "Vous avez sûrement une justification, mais si je commence à faire des exceptions concernant les retards, comment discipliner les autres élèves ?",
