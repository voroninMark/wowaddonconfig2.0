{
["arg2"] = "Bestbounty-TarrenMill",
["type"] = "SAY",
["time"] = 1716369998,
["arg1"] = "1",
["clColor"] = "ffffffff",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716370080,
["arg1"] = "On dirait que c’est la fin de votre aventure.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716370083,
["arg1"] = "Comment ça ? Où est Sarkareth ?",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716370085,
["arg1"] = "Tu n’as jamais eu l’intention de nous mener à Sarkareth.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716370088,
["arg1"] = "Tu as toujours été le plus malin des deux, Irion.",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
["time"] = 1716370093,
["arg1"] = "Je ne peux plus… bouger…",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716370096,
["arg1"] = "Qui… qui êtes-vous ?",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716370100,
["arg1"] = "Je suis le murmure dans les ténèbres.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716370103,
["arg1"] = "J’espérais que vous comprendriez la valeur de mes dons. Mais vous les avez refusés.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716370109,
["arg1"] = "Les Dracthyrs les ont acceptés de bon cœur. Leur rôle a toujours été de servir.",
},
{
["arg2"] = "Altesse-ailée Dezran",
["type"] = "MONSTER_SAY",
["time"] = 1716370115,
["arg1"] = "Nous ne nous inclinerons jamais, traître !",
},
