["type"] = "MONSTER_SAY",
["time"] = 1715975185,
["arg1"] = "Ah… Je ne sais pas quoi faire de vos semblables. Pourquoi avoir amené votre guerre sur nos rivages ? Pourquoi combattez-vous cette… Horde ?",
