["type"] = "MONSTER_SAY",
["time"] = 1724583312,
["arg1"] = "Non, vous ne devez rien faire, Orweyna. L’auriez-vous oublié ? Nous ne pouvons pas intervenir !",
},
{
["arg2"] = "Moissonneur du Sang noir",
["type"] = "MONSTER_SAY",
["time"] = 1724583327,
["arg1"] = "Rien n’arrêtera… cette puissance…",
},
{
["arg2"] = "Orweyna",
["type"] = "MONSTER_SAY",
["time"] = 1724583330,
["arg1"] = "Ils ont construit des extracteurs qui puisent le Sang noir de la terre… combien devons-nous en détruire pour ébranler leur production ?",
},
{
["arg2"] = "Hannan",
["type"] = "MONSTER_SAY",
["time"] = 1724583337,
["arg1"] = "Détruire ? Orweyna, s’il vous plaît. Renoncez avant que la situation n’empire.",
},
{
["arg2"] = "Orweyna",
["type"] = "MONSTER_SAY",
["time"] = 1724583341,
["arg1"] = "Entendez-vous le doux ronronnement qu’émet cet appareil ? Il leur permet de se rétablir après avoir été exposés à la substance. Quelle… inventivité.",
},
{
["arg2"] = "Hannan",
["type"] = "MONSTER_SAY",
["time"] = 1724583351,
["arg1"] = "Vous en avez assez vu. Nous devons rentrer.",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724583403,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583434,
["arg1"] = "Nous y voilà. Le haut-mandataire Eirich… ou est-ce juste Eirich maintenant ?",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583437,
["arg1"] = "Il s’est enfui de la Salle de l’Éveil pour se réfugier dans la Cavepierre.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583441,
["arg1"] = "Il fuit sans doute comme une petite souris. Une petite bête efflanquée, recroquevillée et craintive !",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583466,
["arg1"] = "Qu’est-ce que c’est ? Ce golem a fusionné avec quelque chose d’autre ?",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583471,
["arg1"] = "Une technologie terrestre enrichie d’adjuvants magiques… Génial !",
},
{
["arg2"] = "Oit-Archimonde",
["type"] = "SAY",
["time"] = 1724583492,
["arg1"] = "Rayon sur Oit",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583510,
["arg1"] = "La porte principale semble verrouillée. L’un ou l’autre de ces chemins devrait nous mener à une console.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583607,
["arg1"] = "Des mandataires des machines ! Dans la Cavepierre ! D’une fidélité inconditionnelle.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583652,
["arg1"] = "Cherchez un autre chariot de mine. S’il y en a un, autant l’utiliser.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583656,
["arg1"] = "À moins que vous ne préfériez marcher…",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583703,
["arg1"] = "Un golem mêlé à la corruption skardyn ? Fascinant !",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583763,
["arg1"] = "Cherchez un tunnel à proximité. Vous devriez pouvoir utiliser un chariot de mine pour retourner au Traitement central.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583779,
["arg1"] = "Le voilà. Regardez-le. On ne peut plus rien pour lui.",
},
{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724583784,
["arg1"] = "On dirait une sorte de justice immanente, mais… finissons-en.",
},
{
["arg2"] = "Oit",
["type"] = "MONSTER_EMOTE",
["time"] = 1724583909,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "ff0070dd",
},
{
["arg2"] = "Prêtre Maro'zik",
["type"] = "MONSTER_SAY",
["time"] = 1724584308,
["arg1"] = "Attention, des Kobyss !",
},
{
["arg2"] = "Prêtre Maro'zik",
["type"] = "MONSTER_SAY",
["time"] = 1724584319,
["arg1"] = "La potion les a attirés ici. Ils ont peut-être pris goût aux potions tombées des falaises.",
},
{
["arg2"] = "Apprentie des Cingletrames pâles",
["type"] = "MONSTER_SAY",
["time"] = 1724584322,
["arg1"] = "Et c’est comme ça que vous montrez l’exemple aux jeunes ?",
},
{
["arg2"] = "Tisse-rat",
["type"] = "MONSTER_SAY",
["time"] = 1724584329,
["arg1"] = "Je veux faire comme mon professeur !",
},
{
["arg2"] = "Professeur Zas'rush",
["type"] = "MONSTER_SAY",
["time"] = 1724584333,
["arg1"] = "Ce petit ne sait pas ce qu’il dit. Veuillez l’excuser.",
},
{
["arg2"] = "Apprentie des Cingletrames pâles",
["type"] = "MONSTER_SAY",
["time"] = 1724584335,
["arg1"] = "Je vais fermer les yeux pour cette fois, mais je vous surveille.",
},
{
["arg2"] = "Surveillant des Cingletrames pâles",
["type"] = "MONSTER_SAY",
["time"] = 1724584342,
["arg1"] = "Qu’est-ce que vous fabriquez ? Arrêtez de tirer au flanc !",
},
{
["arg2"] = "Ouvrière Yareh'losh",
["type"] = "MONSTER_SAY",
["time"] = 1724584352,
["arg1"] = "J’y suis peut-être allée un peu fort. Je voulais juste le pousser…",
},
{
["arg2"] = "Alchimiste Talbax",
["type"] = "MONSTER_SAY",
["time"] = 1724584363,
["arg1"] = "Sentez-vous le changement dans l’air ? Les gens du quartier Soyeux se soulèvent.",
},
{
["arg2"] = "Alchimiste Talbax",
["type"] = "MONSTER_SAY",
["time"] = 1724584368,
["arg1"] = "Votre travail ici a beau être terminé, le mien ne fait que commencer. Où est le mal à tirer profit d’une petite révolution ?",
},
{
["arg2"] = "Tka'ktath",
["type"] = "MONSTER_EMOTE",
["time"] = 1724584377,
["arg1"] = "L’ombre d’une bête affamée se déplace au-dessus de la ville.",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724584392,
["arg1"] = "C’est mon seul sac à entrailles. Ne m’en demandez pas d’autre.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584539,
["arg1"] = "L’expédition a conçu le prieuré comme un lieu de contemplation des mystères de Beledar.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584547,
["arg1"] = "Mais depuis peu, ses fidèles agissent en cachette et sont devenus hostiles.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584554,
["arg1"] = "Les gardes voulaient vous tuer ? Le capitaine Dailcri a quelque chose à cacher.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584561,
["arg1"] = "Ses lieutenants renforcent sa tactique. Attirez-les au loin et terrassez-les.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584664,
["arg1"] = "Plus possible de faire marche arrière. Vous allez devoir combattre Dailcri.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584672,
["arg1"] = "Plus possible de faire marche arrière. Vous allez devoir combattre Dailcri.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584679,
["arg1"] = "Plus possible de faire marche arrière. Vous allez devoir combattre Dailcri.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584730,
["arg1"] = "Dailcri était un héros arathi. Comment le prieuré l’a-t-il contraint à se retourner contre Sainte-Chute ?",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_SAY",
["time"] = 1724584773,
["arg1"] = "Leur mission est remplie. Baron, montrez votre valeur.",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_SAY",
["time"] = 1724584779,
["arg1"] = "Quiconque s’oppose à l’empereur mordra la poussière !",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584814,
["arg1"] = "Murrpray a changé le prieuré. D’un lieu de contemplation, elle en a fait le théâtre d’un soulèvement. Pourquoi ?",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584824,
["arg1"] = "Elle a toujours prôné la volonté de l’empereur. Mais se retourner contre nous est une folie.",
},
{
["arg2"] = "Soeur Etna Blayze",
["type"] = "MONSTER_SAY",
["time"] = 1724584852,
["arg1"] = "Quelle hérésie ! Ils souillent la Flamme sacrée en dirigeant les morts. Ils ne valent pas mieux que les Kobyss !",
},
{
["arg2"] = "Kojihmonk-Hyjal",
["type"] = "SAY",
["time"] = 1724584941,
["arg1"] = "Purify on Kojihmonk",
["clColor"] = "ff00ff98",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724585077,
["arg1"] = "C’est une patte. Une patte de Nérubien. C’est…",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724585081,
["arg1"] = "Juste ciel ! C’est une patte de Nérubien sublimé !",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724585081,
["arg1"] = "Vous avez l’air de nager comme une pierre. J’ai des concoctions qui peuvent vous aider à nager, mais… elles ne sont pas gratuites.",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724585085,
["arg1"] = "Ah, mon amie de peu de pattes. La situation ici est peut-être plus grave encore que je ne le craignais.",
},
{
["arg2"] = "Cherchefoie",
["type"] = "MONSTER_SAY",
["time"] = 1724585127,
["arg1"] = "Gyar gar har gar !",
},
{
["arg2"] = "Kaheti capturé",
["type"] = "MONSTER_EMOTE",
["time"] = 1724585162,
["arg1"] = "La créature nérubienne vous remercie d’un signe de la tête avant de s’éloigner à la nage.",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724585350,
["arg1"] = "Les élixirs que je concocterai avec ces ingrédients entreront dans la légende !",
},
{
["arg2"] = "Al'kubian",
["type"] = "MONSTER_SAY",
["time"] = 1724585356,
["arg1"] = "Je ne sais pas encore de quoi il s’agira… mais ils seront légendaires !",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724585391,
["arg1"] = "Vous avez une minute, Oit ?",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724585393,
["arg1"] = "Cet endroit grouille de Gobelins de la KapitalRisk.",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724585406,
["arg1"] = "Je vais aller tendre l’oreille. Ils ne me diront rien, mais je pourrai peut-être surprendre une conversation. Rejoignez-moi à l’auberge quand vous aurez fini.",
},
{
["arg2"] = "Sammy Virevolts",
["type"] = "MONSTER_SAY",
["time"] = 1724585434,
["arg1"] = "J’ai parié avec Thad que nous allions mourir dans les tunnels en creusant notre passage en direction d’Azj-Kahet. C’est le seul pari que je suis content d’avoir perdu !",
},
{
["arg2"] = "Murfie",
["type"] = "MONSTER_SAY",
["time"] = 1724585444,
["arg1"] = "Nous avons de temps en temps des Flairans, mais la plupart de mes clients sont de la KapitalRisk. À chaque jour, sa nouvelle histoire sur un mauvais patron… Jenni Boumboucle est un nom qui revient souvent. Mais au moins, tout ça contribue à maintenir Corby dans le circuit !",
},
{
["arg2"] = "Grigg",
["type"] = "MONSTER_SAY",
["time"] = 1724585453,
["arg1"] = "Plagistes, SA n’est en réalité qu’une filiale de la KapitalRisk. Qu’on l’admette ou non, tout le monde ici suit la même ligne de conduite.",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724585465,
["arg1"] = "Oh, Jenni, regardez ! De nouveaux visages ! Bonjour !",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724585468,
["arg1"] = "Ne changez pas de sujet, Rhubarn ! C’est malpoli.",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724585470,
["arg1"] = "Oui, c’est moi qui dirige ici. Vous avez un problème ? Tant pis. Je m’en fiche.",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724585479,
["arg1"] = "Jenni. Imaginons que nous échangions quelques-uns de mes futurs flacons de parfum contre votre tout nouveau modèle de chapeau de désinsectisation. En supposant qu’il fonctionne…",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724585489,
["arg1"] = "D’accord ! Pourquoi pas huit flacons de parfum par chapeau ?",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724585493,
["arg1"] = "HUIT ?!",
},
{
["arg2"] = "Flairane influençable",
["type"] = "MONSTER_SAY",
["time"] = 1724585511,
["arg1"] = "Ce chapeau est super efficace !",
},
{
["arg2"] = "Flairane influençable",
["type"] = "MONSTER_SAY",
["time"] = 1724585520,
["arg1"] = "Il me faut un de ces chapeaux. J’espère qu’ils ne seront pas en rupture de stock…",
},
{
["arg2"] = "Immopal-Dalaran",
["type"] = "SAY",
["time"] = 1724585788,
["arg1"] = "Infestation sur Immopal",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Grigg",
["type"] = "MONSTER_SAY",
["time"] = 1724586048,
["arg1"] = "Jenni ! Des nageurs viennent de voir des insectes à la piscine !",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724586051,
["arg1"] = "Ils auraient mieux fait d’acheter des chapeaux de désinsectisation.",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724586060,
["arg1"] = "Ils ne sont pas en ville, n’est-ce pas ?",
},
{
["arg2"] = "Grigg",
["type"] = "MONSTER_SAY",
["time"] = 1724586062,
["arg1"] = "Non, ils sont dans la grotte que nous avons empruntée pour venir ici. Allons-y, je vais vous montrer !",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724586068,
["arg1"] = "Arf, très bien, je viens aussi.",
},
{
["arg2"] = "Grigg",
["type"] = "MONSTER_SAY",
["time"] = 1724586072,
["arg1"] = "Là !",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724586073,
["arg1"] = "Oh là là ! Cette grotte est pleine d’insectes !",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724586075,
["arg1"] = "Vous avez « réparé » la grotte ? Votre nouvelle odeur attire un nid !",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724586079,
["arg1"] = "Au moins, certains savent apprécier une bonne odeur.",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724586082,
["arg1"] = "Hé, si votre répulsif ne sentait pas mauvais, nous n’en serions pas là.",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586083,
["arg1"] = "Oit, donnons-leur un coup de main.",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724586087,
["arg1"] = "Pourriez-vous payer plus cher un parfum différent, même s’il est moins efficace ?",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724586092,
["arg1"] = "PLUS ? Vous vous moquez de moi ? Je devrais avoir le choix entre plusieurs senteurs !",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586097,
["arg1"] = "La senteur que je recherche est celle du barbecue.",
},
{
["arg2"] = "Jenni Boumboucle",
["type"] = "MONSTER_SAY",
["time"] = 1724586172,
["arg1"] = "Très bien. Laissons-le empester pour le moment.",
},
{
["arg2"] = "Rhubarn",
["type"] = "MONSTER_SAY",
["time"] = 1724586176,
["arg1"] = "Merci pour cette solution aussi radicale qu’efficace !",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586179,
["arg1"] = "Puanteur ! Radicalité ! Tout le monde est heureux.",
},
{
["arg2"] = "Grigg",
["type"] = "MONSTER_SAY",
["time"] = 1724586183,
["arg1"] = "Je suis surtout heureux de rester en vie.",
},
{
["arg2"] = "Alleria Coursevent",
["type"] = "MONSTER_SAY",
["time"] = 1724586373,
["arg1"] = "Pressons-nous, Oit. Prévenons les autres de nos découvertes.",
},
{
["arg2"] = "Parle-nature Na'layro",
["type"] = "MONSTER_SAY",
["time"] = 1724586428,
["arg1"] = "Marchez doucement ! Ils peuvent entendre vos pas.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586652,
["arg1"] = "Oit, par ici.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586660,
["arg1"] = "Les troupes du grand général Zev’kall se rassemblent à nouveau au nord-est.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586665,
["arg1"] = "Les renseignements fournis par Gazleu, sur ordre de la Tisserande, montrent que nos propres troupes ne sont pas assez nombreuses pour les attaquer de front.",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586674,
["arg1"] = "Pardon, mais je n’ai pas besoin qu’on me donne d’ode… euh, d’ordre. Ah ! Vous avez compris.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586680,
["arg1"] = "De mon côté, j’ai découvert une piste. Un vieil ami à moi a été capturé par les Nérubiens il y a des années.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586687,
["arg1"] = "Il se trouverait du côté où nous allons. Après tout ce temps, je dois savoir ce qui lui est arrivé.",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586694,
["arg1"] = "Oit, pourriez-vous m’apporter mon bouclier ?",
},
{
["arg2"] = "Faerin Lothar",
["type"] = "MONSTER_SAY",
["time"] = 1724586707,
["arg1"] = "Merci. Gazleu, qu’en pensez-vous ?",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586710,
["arg1"] = "J’ai cru que vous ne le demanderiez jamais. Alors voilà, on va entrer à trois pour les attaquer à revers.",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586716,
["arg1"] = "Et dans ce but, je vous suggère d’emporter un bon vieux sac d’en-carabées.",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586720,
["arg1"] = "J’ai une idée pour neutraliser leurs balistes. Et plus précisément, pour les faire exploser.",
},
{
["arg2"] = "Monte Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1724586747,
["arg1"] = "Ce sera parfait !",
},
{
["arg2"] = "Faerin Lothar",
