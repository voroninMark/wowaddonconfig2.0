{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490726,
["arg1"] = "Tirer sur tout. Même sur tendres-pattes comme vous !",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490734,
["arg1"] = "Voilà pourquoi jamais faire confiance Têtes-de-Caillasse. Euh… sauf nouveaux amis. Eux gentils.",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490754,
["arg1"] = "Il y a longtemps, Kobolds pas chevaucher taupes. Trop gros, trop peur. Monter sur taupe ? Non merci !",
},
{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490760,
["arg1"] = "Mais Mipsy était tendre-patte curieuse. Elle pas peur. Voulait être amie des taupes.",
