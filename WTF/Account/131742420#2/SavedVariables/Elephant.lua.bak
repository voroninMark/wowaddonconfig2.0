["time"] = 1724437183,
["arg1"] = "Les sbires de Heurtacier ? Gardes ! Gardes !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724437205,
["arg1"] = "Non, ils servent cette vieille sotte de sœur Blayze. Détruisez ces étrangers !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724437221,
["arg1"] = "Elle n’est plus utile à l’Empire. Bientôt, les vrais fidèles se lèveront, et Arathi retrouvera toute sa puissance !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724437243,
["arg1"] = "Tiens, tiens, qui voilà ? Des indésirables !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724437251,
["arg1"] = "La gloire guide mon marteau !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724437260,
["arg1"] = "Par le feu, suis-je guéri !",
},
{
["arg2"] = "Baron Braunpique",
["type"] = "MONSTER_YELL",
["time"] = 1724437265,
["arg1"] = "Ma première… défaite…",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724437309,
["arg1"] = "Beledar est le creuset. Il consume les faiblesses. Sa lumière aveuglante révèle à nous autres du peuple arathi la force qui nous manquait.",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724437317,
["arg1"] = "Avec une armée de ressuscités, le peuple arathi vaincra les Nérubiens, conquerra Khaz Algar et soumettra le monde !",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724437335,
["arg1"] = "Pauvres gens du dehors ! La Flamme sacrée de Beledar le relèvera.",
},
{
["arg2"] = "Prieuresse Murrpray",
["type"] = "MONSTER_YELL",
["time"] = 1724437358,
["arg1"] = "La Flamme sacrée purifiera vos crimes !",
},
