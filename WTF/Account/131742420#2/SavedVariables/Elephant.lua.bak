{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_YELL",
["time"] = 1715507142,
["arg1"] = "Centaures ! Que tonnent vos sabots et que sonnent vos cors ! La rage d’Ohn’ahra vous guidera !",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_YELL",
["time"] = 1715507152,
["arg1"] = "Shikaars ! Suivez votre khan, frappez au diapason du tonnerre !",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_YELL",
