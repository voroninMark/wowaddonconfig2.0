["type"] = "MONSTER_SAY",
["time"] = 1699457554,
["arg1"] = "L’heure de la floraison de l’Arbre-Monde approche et nos adversaires se rassemblent dans le Rêve d’émeraude. Venez.",
},
{
["arg2"] = "Aboyeuse du comptoir",
["type"] = "MONSTER_SAY",
["time"] = 1699457655,
["arg1"] = "Hé, bonjour ! Venez donc découvrir les nouveaux articles du comptoir. Nous venons justement de recevoir une livraison !",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699457691,
["arg1"] = "Spacewølf, pourrais-je vous entretenir de quelque chose ?",
},
{
["arg2"] = "Mystique Chapoiseau",
["type"] = "MONSTER_SAY",
["time"] = 1699457991,
["arg1"] = "Votre yack est dans une autre écurie.",
},
{
["arg2"] = "Cousin Mains Lentes",
["type"] = "MONSTER_SAY",
["time"] = 1699457993,
["arg1"] = "J’allais donner une fête et inviter le mystique Chapoiseau, mais vous l’avez congédié.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458099,
["arg1"] = "Spacewølf, pourrais-je vous entretenir de quelque chose ?",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458206,
["arg1"] = "Je vous retrouverai à Lunedane. Venez prestement et discrètement.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458355,
["arg1"] = "Nous allons éliminer juste assez de Primalistes pour ne pas courir de risque. C’est une mission de renseignement, pas de combat.",
},
{
["arg2"] = "Parleflamme ardente",
["type"] = "MONSTER_SAY",
["time"] = 1699458397,
["arg1"] = "Nos récompenses nous attendent !",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458436,
["arg1"] = "Attendez… Ce ne sont pas des Primalistes…",
},
{
["arg2"] = "Parleflamme ardent",
["type"] = "MONSTER_SAY",
["time"] = 1699458507,
["arg1"] = "Je… renaîtrai… dans les flammes !",
},
{
["arg2"] = "Parleflamme ardent",
["type"] = "MONSTER_SAY",
["time"] = 1699458509,
["arg1"] = "Mes cendres… nourriront cette terre…",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458513,
["arg1"] = "Ce sont des druides !",
},
{
["arg2"] = "Parleflamme ardente",
["type"] = "MONSTER_SAY",
["time"] = 1699458557,
["arg1"] = "Mes cendres… nourriront cette terre…",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458596,
["arg1"] = "Bien. Les flammes qui bloquaient le pont doivent être éteintes, à présent.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458601,
["arg1"] = "Est-ce que vous voyez la fleur près du pont ? Allons voir ça de plus près.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458607,
["arg1"] = "Les druides ne détruisent pas la flore locale, ils… ils déversent leur magie du feu en elle.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458615,
["arg1"] = "Nous ferions bien de la rapporter aux Aspects, avec les autres échantillons que nous trouverons. Dites-moi quand vous voudrez commencer.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458632,
["arg1"] = "Prenez cette fleur. Après, nous approcherons discrètement des Incarnations. N’oubliez surtout pas d’éviter les flammes.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458642,
["arg1"] = "De la brume protectrice… Ces nappes devraient nous protéger des flammes partout où il y en a.",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458647,
["arg1"] = "Tu m’as dit de ne pas faire de mal à leurs enfants chéris.",
},
{
["arg2"] = "Vyranoth",
["type"] = "MONSTER_SAY",
["time"] = 1699458652,
["arg1"] = "Et donc, tu t’es allié à ces… fanatiques des flammes ?",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458674,
["arg1"] = "On doit trouver comment entrer dans ce Rêve. Ils connaissent le chemin.",
},
{
["arg2"] = "Vyranoth",
["type"] = "MONSTER_SAY",
["time"] = 1699458679,
["arg1"] = "Ils ne partagent pas notre cause. Que leur as-tu promis ?",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458689,
["arg1"] = "Ils n’ont pas besoin qu’on les pousse.",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458692,
["arg1"] = "Ils cherchent l’immortalité dans la flamme vivante et le plaisir de la destruction !",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458697,
["arg1"] = "On peut se cacher dans les buissons plus loin. Restez loin des Incarnations.",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458700,
["arg1"] = "Ah. Tu ne pourrais pas t’amuser un peu ?",
},
{
["arg2"] = "Vyranoth",
["type"] = "MONSTER_SAY",
["time"] = 1699458701,
["arg1"] = "Ne crains-tu pas qu’on perde de vue nos objectifs ?",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458703,
["arg1"] = "Je pense qu’on ne craint rien ici, tant qu’ils restent concentrés l’un sur l’autre.",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458706,
["arg1"] = "Absurde ! La victoire est à notre portée !",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458709,
["arg1"] = "Avec nos nouveaux alliés, nous serons plus puissants que jamais.",
},
{
["arg2"] = "Vyranoth",
["type"] = "MONSTER_SAY",
["time"] = 1699458714,
["arg1"] = "Ce n’est pas le sens de mes propos, Fyrakka.",
},
{
["arg2"] = "Fyrakka",
["type"] = "MONSTER_SAY",
["time"] = 1699458717,
["arg1"] = "Suis-moi au lieu de t’en faire. Je veux te montrer quelque chose.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458775,
["arg1"] = "Les druides ont ouvert des portails ici ! Impossible de revenir sur nos pas.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458779,
["arg1"] = "Je vais repousser tout ce qui traverse. Vous, éliminez vite le gardien ! Nous pourrons nous échapper ensuite.",
},
{
["arg2"] = "Larodar, gardien de la flamme",
["type"] = "MONSTER_SAY",
["time"] = 1699458840,
["arg1"] = "Levez-vous, mes enfants ! Déchaînez vos flammes enragées ! Nourrissez ces terres des cendres de nos adversaires !",
},
{
["arg2"] = "Larodar, gardien de la flamme",
["type"] = "MONSTER_SAY",
["time"] = 1699458846,
["arg1"] = "Le Rêve… m’appelle… Je dois y répondre…",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458869,
["arg1"] = "Prenez ce sifflet. Un de mes hippogriffes pourra vous ramener rapidement à Valdrakken.",
},
{
["arg2"] = "Shandris Pennelune",
["type"] = "MONSTER_SAY",
["time"] = 1699458878,
["arg1"] = "Qu’Élune veille sur vous, Spacewølf. Et sur nous tous.",
},
{
["arg2"] = "Capitaine Drine",
["type"] = "MONSTER_SAY",
["time"] = 1699458903,
["arg1"] = "Ça explique pourquoi Fyrakka concentrait son assaut contre les plaines d’Ohn’ahra.",
},
{
["arg2"] = "Capitaine Drine",
["type"] = "MONSTER_SAY",
["time"] = 1699458910,
["arg1"] = "Je vais rejoindre… Un instant. Ce froid soudain, vous le sentez ?",
},
{
["arg2"] = "Capitaine Drine",
["type"] = "MONSTER_SAY",
["time"] = 1699458917,
["arg1"] = "Par les Aspects… Elle est là.",
},
{
["arg2"] = "Capitaine Drine",
["type"] = "MONSTER_SAY",
["time"] = 1699458921,
["arg1"] = "Gardes ! Rejoignez la corniche inférieure ! Spacewølf, suivez-nous et préparez-vous au combat.",
},
{
["arg2"] = "Vyranoth",
["type"] = "MONSTER_SAY",
["time"] = 1699458958,
["arg1"] = "Je trouverai Alexstrasza. Vous ne m’arrêterez pas.",
},
{
["arg2"] = "Capitaine Drine",
["type"] = "MONSTER_SAY",
["time"] = 1699459098,
["arg1"] = "Gardes, regagnez vos postes.",
},
{
["arg2"] = "Hanu",
["type"] = "MONSTER_SAY",
["time"] = 1699459256,
["arg1"] = "Les araignées sont affamées ! Libérez nos camarades avant qu’elles ne les dévorent.",
},
{
["arg2"] = "Gérithus",
["type"] = "MONSTER_SAY",
["time"] = 1699459603,
["arg1"] = "Bienvenue dans le Rêve d’émeraude ! Ma mère vous attend un peu plus loin. Il faut que je recouvre mes forces…",
},
{
["arg2"] = "Somnikus",
["type"] = "MONSTER_SAY",
["time"] = 1699459610,
["arg1"] = "Méfiez-vous. Je sens planer une magie ancienne et secrète ici.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699459613,
["arg1"] = "Bienvenue dans le Rêve. Au-delà de ces rivages, l’Arbre-Monde vous attend.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699459706,
["arg1"] = "Les dragons féériques sont des créatures hors norme, colorées et imprévisibles. Envolez-vous et voyez comme ils déploient leurs ailes.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699459736,
["arg1"] = "Cénarius, combien de temps faudra-t-il à Fyrakka pour atteindre l’Arbre ?",
},
{
["arg2"] = "Cénarius",
["type"] = "MONSTER_SAY",
["time"] = 1699459741,
["arg1"] = "Il ne le menace pas encore directement, ma sœur. Mais à chaque seconde qui passe, le danger s’accroît.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699459747,
["arg1"] = "Nous devons rassembler plus d’alliés à nos côtés. Les dieux sauvages viendront-ils ?",
},
{
["arg2"] = "Cénarius",
["type"] = "MONSTER_SAY",
["time"] = 1699459752,
["arg1"] = "Certains sont déjà là. Mais nous devons convoquer plus de monde encore et rallier les citoyens du Rêve.",
},
{
["arg2"] = "Lapin de Nuo",
["type"] = "MONSTER_EMOTE",
["time"] = 1699459874,
["arg1"] = "Les visions d’$gun:une; jeune $grêveur:rêveuse; emplissent les environs des champs des Rêveries !",
},
{
["arg2"] = "Tyrande Murmevent",
["type"] = "MONSTER_SAY",
["time"] = 1699459907,
["arg1"] = "Je vais retrouver les autres Kaldorei au pied de l’Arbre. Nous installons là le cœur de notre défense.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699459913,
["arg1"] = "Entendu. Nous vous enverrons des renforts dès que possible.",
},
{
["arg2"] = "Goldrinn",
["type"] = "MONSTER_SAY",
["time"] = 1699459976,
["arg1"] = "Et je réponds à l’appel de la meute ! Ensemble, nous protégerons le Rêve, ainsi que l’Arbre !",
},
{
["arg2"] = "Q'onzu",
["type"] = "MONSTER_SAY",
["time"] = 1699459993,
["arg1"] = "Pourquoi voudrais-je empêcher le Rêve de changer ? Je pense que je vais attendre de voir ce qui se produit. Essayez de ne pas mourir, mortelle.",
},
{
["arg2"] = "Ancienne Cassaphine",
["type"] = "MONSTER_SAY",
["time"] = 1699460009,
["arg1"] = "Apporter mon aide… ou chercher le renouveau ?",
},
{
["arg2"] = "Ancienne Cassaphine",
["type"] = "MONSTER_SAY",
["time"] = 1699460016,
["arg1"] = "Les portails sont ouverts ! Les flammes sont là !",
},
{
["arg2"] = "Parleflamme envahisseuse",
["type"] = "MONSTER_SAY",
["time"] = 1699460076,
["arg1"] = "Sacrifice et sanctification !",
},
{
["arg2"] = "Parleflamme envahisseuse",
["type"] = "MONSTER_SAY",
["time"] = 1699460082,
["arg1"] = "Notre mort… retarde seulement… notre ascension…",
},
{
["arg2"] = "Cendrir Cerfbois",
["type"] = "MONSTER_SAY",
["time"] = 1699460131,
["arg1"] = "Acceptez la flamme dans votre cœur et grandissez.",
},
{
["arg2"] = "Parleflamme envahisseur",
["type"] = "MONSTER_SAY",
["time"] = 1699460133,
["arg1"] = "Notre mort… retarde seulement… notre ascension…",
},
{
["arg2"] = "Ancienne Cassaphine",
["type"] = "MONSTER_SAY",
["time"] = 1699460136,
["arg1"] = "Mon cœur brûle d’un renouveau.",
},
{
["arg2"] = "Ancienne Cassaphine",
["type"] = "MONSTER_SAY",
["time"] = 1699460136,
["arg1"] = "Mon cœur brûle d’un renouveau.",
},
{
["arg2"] = "Parleflamme envahisseur",
["type"] = "MONSTER_SAY",
["time"] = 1699460139,
["arg1"] = "Le feu… restaure tout…",
},
{
["arg2"] = "Moruud Brise-Récifs",
["type"] = "MONSTER_EMOTE",
["time"] = 1699460166,
["arg1"] = "Les racines d’Amirdrassil s’ébranlent tandis que de puissantes vagues se brisent contre le rivage. Quelque chose se cache sous la surface et menace l’île.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460166,
["arg1"] = "Dès que je ferme leurs portails, d’autres apparaissent.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460308,
["arg1"] = "Attention !",
},
{
["arg2"] = "Igira la Cruelle",
["type"] = "MONSTER_SAY",
["time"] = 1699460316,
["arg1"] = "Voyez les armes de l’ombreflamme… et votre fin.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460322,
["arg1"] = "Suivez-moi ! Prenez le portail !",
},
{
["arg2"] = "Igira la Cruelle",
["type"] = "MONSTER_SAY",
["time"] = 1699460325,
["arg1"] = "Volez, petit Dragon. Ma plus grande création va vous rogner les ailes.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460337,
["arg1"] = "Amirdrassil ! « Couronne d’Harmonie. » Le fruit de deux royaumes, une fenêtre entre la mort et la vie.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460376,
["arg1"] = "Nous, les membres du Vol draconique vert, avons juré de le protéger, comme l’ont fait tant d’âmes perdues. Notre Vol doit rester vigilants jusqu’à ce qu’il prenne sa place dans le monde.",
},
{
["arg2"] = "Tyrande Murmevent",
["type"] = "MONSTER_SAY",
["time"] = 1699460382,
["arg1"] = "Mérithra, je dois vous parler. L’une des anciennes dryades approche, mais elle n’est plus… elle-même. Elle ne fait plus qu’un avec la Flamme.",
},
{
["arg2"] = "Tyrande Murmevent",
["type"] = "MONSTER_SAY",
["time"] = 1699460398,
["arg1"] = "Les Kaldorei ont intercepté l’ancienne Cassaphine à la lisière d’Amirdrassil. Nous l’abattrons s’il le faut, Mérithra.",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460405,
["arg1"] = "Allez-y, Tyrande. Vous aussi, Spacewølf. J’ai le cœur lourd à l’idée de perdre une autre personne qui m’est chère, mais nous n’avons ni le temps ni le choix.",
},
{
["arg2"] = "Ancienne Cassaphine",
["type"] = "MONSTER_SAY",
["time"] = 1699460414,
["arg1"] = "Vous… vous battez… pour des cendres…",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1699460415,
