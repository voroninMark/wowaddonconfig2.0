["arg1"] = "Interruption de Aigle alpha |cff71d5ff|Hspell:377389:0|h[Appel de la nuée]|h|r !",
["clColor"] = "ffa330c9",
},
{
["arg2"] = "Malinor",
["type"] = "MONSTER_SAY",
["time"] = 1717184945,
["arg1"] = "Il y a trop d’oiseaux ici ! Aidez-nous à nous en débarrasser !",
},
{
["arg2"] = "Spell Bunny",
["type"] = "MONSTER_EMOTE",
["time"] = 1717184945,
["arg1"] = "D’autres aigles sont en approche.",
},
{
["arg2"] = "Suskry-Hyjal",
