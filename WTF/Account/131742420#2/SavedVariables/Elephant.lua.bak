{
["arg2"] = "Mamie Gribouille",
["type"] = "MONSTER_SAY",
["time"] = 1724490700,
["arg1"] = "« Tuer rats ! », Têtes-de-Caillasse hurler. « Purger infestation ! ». Tirer partout. Brûler tout.",
