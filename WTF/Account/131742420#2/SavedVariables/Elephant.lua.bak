},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1725461084,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Mère des couvées des flagelleurs des profondeurs",
["type"] = "MONSTER_EMOTE",
["time"] = 1725461086,
["arg1"] = "Les cavernes tremblent ! Des rafales de vent naissent sous le battement d’ailes invisibles ! La mère des couvées a pris son envol.",
},
{
["arg2"] = "Kyron le Grand",
["type"] = "MONSTER_SAY",
["time"] = 1725461453,
["arg1"] = "Les falotiers ne peuvent pas faire plus. Si nous voulons survivre, nous devons nous établir sur des terres dans l’ombre de Beledar.",
},
{
["arg2"] = "Kyron le Grand",
["type"] = "MONSTER_SAY",
["time"] = 1725461471,
["arg1"] = "Les Kobyss s’approchent de la Prétention de Velhan. Protégez les habitantes et habitants.",
},
{
["arg2"] = "Kronf",
["type"] = "MONSTER_EMOTE",
["time"] = 1725461491,
["arg1"] = "Vous percevez un glyphe de vol dynamique à proximité.",
["clColor"] = "fff48cba",
},
{
["arg2"] = "Kyron le Grand",
["type"] = "MONSTER_SAY",
["time"] = 1725461540,
["arg1"] = "Les créatures des ténèbres usent de la peur pour chasser le peuple arathi. Mais c’est terminé. Dans les fermes, dans nos rangs, les gens ont retrouvé leur courage.",
},
{
["arg2"] = "Kyron le Grand",
["type"] = "MONSTER_SAY",
["time"] = 1725461561,
["arg1"] = "Les cours d’eau ont toujours été traîtres à Sainte-Chute. Des prédateurs sous-marins y pullulent et attaquent les pêcheurs. Éliminez-les.",
},
{
["arg2"] = "Sombre-défense",
