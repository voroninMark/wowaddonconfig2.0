{
["arg2"] = "Amiral du ciel Rogers",
["type"] = "MONSTER_SAY",
["time"] = 1715973352,
["arg1"] = "Ventenuit, au rapport ! Comment ça se passe de votre côté ?",
},
{
["arg2"] = "Rell Ventenuit",
["type"] = "MONSTER_SAY",
["time"] = 1715973357,
["arg1"] = "Nous sommes de l’Alliance, nous ne vous voulons aucun mal. Dites-moi, quelle est cette ombre qui me possédait ?",
