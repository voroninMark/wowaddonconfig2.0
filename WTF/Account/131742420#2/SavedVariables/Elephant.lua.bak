},
{
["arg2"] = "Capitaine Torgoley « Le Magot »",
["type"] = "MONSTER_SAY",
["time"] = 1715977209,
["arg1"] = "Par la Lumière… Theramore ! Qu’est-ce qui s’est passé ?!",
},
{
["arg2"] = "Capitaine Torgoley « Le Magot »",
["type"] = "MONSTER_SAY",
["time"] = 1715977214,
["arg1"] = "Abe, descends dans les quartiers et cache-toi. Les autres, ouvrez l’œil et préparez-vous à vous défendre.",
},
{
["arg2"] = "Abe, le mousse",
["type"] = "MONSTER_SAY",
["time"] = 1715977218,
["arg1"] = "O-oui, chef !",
},
{
["arg2"] = "Capitaine Torgoley « Le Magot »",
["type"] = "MONSTER_SAY",
["time"] = 1715977219,
["arg1"] = "Si quelqu’un est assez courageux pour aller voir ce qui s’est passé, nous allons rester ici aussi longtemps que possible avec le bateau.",
},
{
["arg2"] = "Soldat de marine Anderson",
["type"] = "MONSTER_SAY",
["time"] = 1715977224,
["arg1"] = "Capitaine ! Que votre équipage reste en sécurité à bord. Nous défendrons le navire s’il est attaqué.",
},
{
["arg2"] = "Dame Jaina Portvaillant",
["type"] = "MONSTER_SAY",
["time"] = 1715977588,
["arg1"] = "Nous ne pouvons pas laisser la Horde récupérer l’iris de focalisation. Éliminez ce qu’il reste de leurs troupes, moi je vais sécuriser l’artéfact.",
},
{
["arg2"] = "Dame Jaina Portvaillant",
["type"] = "MONSTER_SAY",
["time"] = 1715977816,
["arg1"] = "Vous avez tous mes plus sincères remerciements. Maintenant que l’iris de focalisation a disparu, cette bombe sans vie n’est plus que l’horrible testament de la brutalité de Garrosh. Le vent du changement souffle violemment ; Azeroth est au bord de la guerre. Veuillez m’excuser, mais je vais devoir vous laisser… J’ai beaucoup de choses à prendre en considération. Au revoir.",
},
{
["arg2"] = "Teng Fleur de Pommier",
["type"] = "MONSTER_SAY",
["time"] = 1715977859,
["arg1"] = "Allons-y. Les tonneaux sont dans le verger.",
},
{
["arg2"] = "Teng Fleur de Pommier",
["type"] = "MONSTER_SAY",
["time"] = 1715977923,
["arg1"] = "Nous ne souhaitons pas nous mêler de votre conflit. Mais je crains que quand la guerre couve à l’horizon, la paix ne soit pas une option.",
},
{
["arg2"] = "Teng Fleur de Pommier",
["type"] = "MONSTER_SAY",
["time"] = 1715977928,
["arg1"] = "Ah, que de pensées inquiétantes. Notre dernier empereur nous avait incités à ne pas vivre dans l’ombre de la peur. Comprenez-vous maintenant pourquoi nous aimons tant boire et faire la fête ?",
},
{
["arg2"] = "Pilote blessé",
["type"] = "MONSTER_SAY",
["time"] = 1715977978,
["arg1"] = "Merci. Le temps de panser mes blessures et je retourne me battre !",
},
{
["arg2"] = "Pilote gravement blessé",
["type"] = "MONSTER_SAY",
["time"] = 1715977988,
["arg1"] = "Je pensais que j’étais perdu. Je vous dois la vie.",
},
{
["arg2"] = "Pilote gravement blessé",
["type"] = "MONSTER_SAY",
["time"] = 1715978001,
["arg1"] = "Je suis vivant ? Ha ! On ne peut pas en dire autant des membres de la Horde au point Garrosh’ar. On leur a mis une raclée.",
},
{
["arg2"] = "Pilote gravement blessé",
["type"] = "MONSTER_SAY",
["time"] = 1715978032,
["arg1"] = "Content de voir un visage de l’Alliance ! J’ai cru que j’allais mourir ici.",
},
{
["arg2"] = "Pilote mortellement blessé",
["type"] = "MONSTER_SAY",
["time"] = 1715978075,
["arg1"] = "Merci de votre aide. Ne vous inquiétez pas, ce n’est qu’une égratignure. Je suis en pleine forme !",
},
{
["arg2"] = "Teng Fleur de Pommier",
["type"] = "MONSTER_SAY",
["time"] = 1715978109,
["arg1"] = "Allons-y. Les tonneaux sont dans le verger.",
},
{
["arg2"] = "Pilote blessé",
["type"] = "MONSTER_SAY",
["time"] = 1715978111,
["arg1"] = "Merci de m’avoir sauvé. C’était chaud là-bas.",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
["time"] = 1715978157,
["arg1"] = "La tempête se lève ! Tenez-vous prêt.",
},
{
["arg2"] = "Maître brasseuse Blanche",
["type"] = "MONSTER_SAY",
