["arg1"] = "Le siège du donjon du Fléau-des-Dragons s’apprête à commencer !",
},
{
["arg2"] = "Thrall",
["type"] = "MONSTER_SAY",
["time"] = 1724435836,
["arg1"] = "Une vision est apparue à travers Azeroth. Un chant radieux. Nous pensons qu’il s’agit d’un avertissement, mais nous ignorons sa signification.",
