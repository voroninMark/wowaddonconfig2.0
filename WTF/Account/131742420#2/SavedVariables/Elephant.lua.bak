["time"] = 1687383037,
["arg1"] = "Une horde de pinces-de-magma commence à se former, menaçant l’écosystème fragile des grottes !",
},
{
["arg2"] = "Rannan Korren",
["type"] = "MONSTER_SAY",
["time"] = 1687383074,
["arg1"] = "La guanite a un potentiel explosif qui passionne un peu trop mes collègues gobelins. Si jamais vous croisez des ailes-de-schiste, il semblerait qu’elles en… déposent.",
},
{
["arg2"] = "Event Controller [DNT]",
["type"] = "MONSTER_EMOTE",
["time"] = 1687383096,
["arg1"] = "La douce mélodie naturelle de la caverne est perturbée par d’affreuses notes discordantes !",
