{
["arg2"] = "Dagran Thaurissan II",
["type"] = "MONSTER_SAY",
["time"] = 1724512808,
["arg1"] = "Cherchez un autre chariot de mine. S’il y en a un, autant l’utiliser.",
},
{
["arg2"] = "Dagran Thaurissan II",
