["arg1"] = "Ah, ce n’est pas terminé. D’après ce que je vois, nous sommes face à l’épreuve du yaungol. Laissez-moi vous éclairer…",
},
{
["arg2"] = "Chroniqueur Pas de Pierre",
["type"] = "MONSTER_YELL",
["time"] = 1715976047,
["arg1"] = "L’histoire raconte qu’un yaungol voyageait dans les plaines de Kun’lai, lorsqu’il se fit attaquer par deux étranges créatures embusquées !",
},
{
["arg2"] = "Osong",
["type"] = "MONSTER_YELL",
["time"] = 1715976055,
["arg1"] = "POUR LES ANCIENS !",
},
{
["arg2"] = "Chroniqueur Pas de Pierre",
["type"] = "MONSTER_YELL",
["time"] = 1715976063,
["arg1"] = "Le yaungol attaqua les bêtes avec force détermination et brutalité. Mais plus il les attaquait, plus les créatures devenaient redoutables.",
},
{
["arg2"] = "Chroniqueur Pas de Pierre",
["type"] = "MONSTER_YELL",
["time"] = 1715976072,
["arg1"] = "Mais lorsqu’il s’arrêta, les bêtes rapetissèrent jusqu’à presque disparaître.",
},
{
["arg2"] = "Chroniqueur Pas de Pierre",
["type"] = "MONSTER_YELL",
["time"] = 1715976105,
["arg1"] = "La morale de cette histoire, c’est que les conflits se nourrissent des conflits. Lorsque la paix envahit votre cœur, le conflit s’en va errer ailleurs.",
},
{
["arg2"] = "Chroniqueur Pas de Pierre",
["type"] = "MONSTER_YELL",
["time"] = 1715976116,
["arg1"] = "Je vous remercie, héros. Vous avez apporté la paix à ce temple sacré.",
},
{
["arg2"] = "Chroniqueur Pas de Pierre",
["type"] = "MONSTER_YELL",
["time"] = 1715976122,
["arg1"] = "Maintenant, partez ! J’ai besoin de méditer avant d’entamer le rituel de restauration.",
},
{
["arg2"] = "Liu Cœur de Flamme",
["type"] = "MONSTER_YELL",
["time"] = 1715976228,
["arg1"] = "Vos forces sont insignifiantes.",
},
{
["arg2"] = "Liu Cœur de Flamme",
