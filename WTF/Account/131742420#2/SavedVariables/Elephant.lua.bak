["arg1"] = "1",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366898,
["arg1"] = "Entre ces murs, j’ai forgé des merveilles qui ont transformé le monde.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366903,
["arg1"] = "Après des millénaires à l’abandon, elles sont aujourd’hui… agitées. Il faudra une volonté de fer pour les faire obéir à nouveau.",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716366914,
["arg1"] = "Je… je suis moi aussi le fruit d’une expérience. Une expérience que ton incarnation précédente a voulu détruire.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366922,
["arg1"] = "Tu es mon sang. Le simple fait que tu aies survécu le prouve.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366934,
["arg1"] = "Les flammes et les ombres… Deux forces puissantes et influentes.",
},
{
["arg2"] = "Neltharion",
["type"] = "MONSTER_SAY",
["time"] = 1716366938,
["arg1"] = "Ensemble, elles forment un tout plus grand encore. Apprends à les maîtriser quand elles sont réunies, et rien ne pourra t’arrêter.",
},
{
["arg2"] = "Pityësz-Ragnaros",
["type"] = "SAY",
["time"] = 1716367359,
["arg1"] = "ty",
["clColor"] = "fff48cba",
