{
["arg2"] = "Clarelle",
["type"] = "MONSTER_SAY",
["time"] = 1715192120,
["arg1"] = "Restez avec nous, vieille branche, on a besoin que vous soyez réveillé !",
},
{
["arg2"] = "Clarelle",
["type"] = "MONSTER_SAY",
["time"] = 1715192191,
["arg1"] = "Oh non, encore ? Allez, vieil arbre noueux. Nous avons du travail !",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1715192317,
["arg1"] = "Ce nouveau monstre est trop puissant pour l’affronter sans aide. Rassemblez des camarades et faites disparaître cette menace !",
},
{
["arg2"] = "Mérithra",
["type"] = "MONSTER_SAY",
["time"] = 1715192390,
["arg1"] = "Vos efforts nous ont offert ce moment de triomphe.",
},
{
["arg2"] = "Chipetruffe",
["type"] = "MONSTER_EMOTE",
["time"] = 1715192436,
["arg1"] = "Le chipetruffe pousse un hululement perçant et s’envole vers le sud-est.",
},
{
["arg2"] = "Icarius",
["type"] = "MONSTER_SAY",
["time"] = 1715192561,
["arg1"] = "J’espère que tout le monde a pu trouver un lieu sûr où se reposer…",
},
{
["arg2"] = "Inconnu",
["type"] = "MONSTER_SAY",
["time"] = 1715192653,
["arg1"] = "C’est un endroit dangereux pour un pique-nique.",
},
{
["arg2"] = "Faënina",
["type"] = "MONSTER_SAY",
["time"] = 1715192655,
["arg1"] = "Mais regardez-moi ce panorama !",
},
{
["arg2"] = "Faënina",
["type"] = "MONSTER_SAY",
["time"] = 1715192656,
["arg1"] = "Les ingrédients vont être tellement frais !",
},
{
["arg2"] = "Faënina",
["type"] = "MONSTER_SAY",
["time"] = 1715192658,
["arg1"] = "Et nos héros nous défendront contre les intrus !",
},
{
["arg2"] = "Kojun",
["type"] = "MONSTER_SAY",
["time"] = 1715192661,
["arg1"] = "Des intrus ?",
},
{
["arg2"] = "Faënina",
["type"] = "MONSTER_SAY",
["time"] = 1715192662,
["arg1"] = "Ceux de la Flamme, par exemple. Eux aussi, ils mangent.",
},
{
["arg2"] = "Kojun",
["type"] = "MONSTER_SAY",
["time"] = 1715192664,
["arg1"] = "C’est vrai. Et nous risquons d’attirer des animaux. Comme une somnichouette…",
},
{
["arg2"] = "Faënina",
["type"] = "MONSTER_SAY",
["time"] = 1715192668,
["arg1"] = "… ou une serre de rêve…",
},
{
["arg2"] = "Kojun",
["type"] = "MONSTER_SAY",
["time"] = 1715192669,
["arg1"] = "… un sabre de rêve !…",
},
{
["arg2"] = "Faënina",
["type"] = "MONSTER_SAY",
["time"] = 1715192670,
["arg1"] = "… OU UN OURS !",
},
{
["arg2"] = "Kojun",
["type"] = "MONSTER_SAY",
["time"] = 1715192672,
["arg1"] = "Ce serait terrifiant.",
},
{
["arg2"] = "Kojun",
["type"] = "MONSTER_SAY",
["time"] = 1715192676,
["arg1"] = "Il se passe tellement de choses. Vous pensez qu’on devrait les aider ?",
},
