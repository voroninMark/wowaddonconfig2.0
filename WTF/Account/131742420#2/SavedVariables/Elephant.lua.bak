["type"] = "MONSTER_SAY",
["time"] = 1725143360,
["arg1"] = "Il est temps de mettre ces petits à l’épreuve, ils ont un destin à accomplir. Incitez-les à retourner au hall des Castes.",
},
{
["arg2"] = "Brandom « le Poussiéreux »",
["type"] = "MONSTER_SAY",
