["arg1"] = "Ohn’irs ! La mère des vents nous appelle sur le sentier de guerre !",
},
{
["arg2"] = "Khan Balakar",
["type"] = "MONSTER_YELL",
["time"] = 1715507161,
["arg1"] = "Ha ! Avec moi, le pouvoir d’Ohn’ahra ira bien au-delà des simples brises et bénédictions.",
