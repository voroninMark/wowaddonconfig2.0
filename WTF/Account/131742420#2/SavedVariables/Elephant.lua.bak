["type"] = "MONSTER_SAY",
["time"] = 1715614451,
["arg1"] = "L’arme de Balakar doit être brisée.",
},
{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_SAY",
["time"] = 1715614457,
["arg1"] = "Il n’est pas digne de siéger aux côtés des illustres khans du passé.",
},
{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_SAY",
["time"] = 1715614466,
["arg1"] = "Merci. Ohn’ahra vole de nouveau librement et, sans l’influence de Balakar, les Nokhuds peuvent panser leurs plaies.",
},
{
