{
["arg2"] = "Haute-mandataire Brinthe",
["type"] = "MONSTER_SAY",
["time"] = 1725460800,
["arg1"] = "Le message n’est pas bien passé : il s’agit de ressources terrestres. Nous avons besoin de vous pour assurer notre défense.",
