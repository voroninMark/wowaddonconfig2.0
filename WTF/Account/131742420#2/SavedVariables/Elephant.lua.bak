["arg1"] = "Bienvenue à tous au théâtre de la Souffrance !",
},
{
["arg2"] = "Grand maître Vole",
["type"] = "MONSTER_YELL",
["time"] = 1742758922,
["arg1"] = "Ces ambitieux semblent croire qu’ils peuvent rivaliser avec les meilleurs combattants de Maldraxxus ! Ha ! J’aimerais bien voir ça !",
