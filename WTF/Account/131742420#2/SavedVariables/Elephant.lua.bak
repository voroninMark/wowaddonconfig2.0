{
["arg2"] = "Altesse-ailée Dezran",
["type"] = "MONSTER_SAY",
["time"] = 1716371009,
["arg1"] = "Quel est cet endroit impie ?",
},
{
["arg2"] = "Irion",
["type"] = "MONSTER_SAY",
["time"] = 1716371014,
["arg1"] = "Cette force est un peu plus loin, on dirait… Elle déborde d’une énergie brute et sombre.",
},
{
["arg2"] = "Altesse-ailée Dezran",
["type"] = "MONSTER_SAY",
["time"] = 1716371024,
["arg1"] = "La quête de pouvoir de Sarkareth a scellé sa perte. Qu’adviendra-t-il de mon peuple ?",
},
{
["arg2"] = "Sabellian",
["type"] = "MONSTER_SAY",
