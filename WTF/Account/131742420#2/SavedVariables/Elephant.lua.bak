["arg1"] = "Interrompu |cff71d5ff|Hspell:377389:0|h[Appel de la nuée]|h|r sur Aigle alpha",
["clColor"] = "ffa330c9",
},
{
["arg2"] = "Suskry-Hyjal",
["type"] = "SAY",
