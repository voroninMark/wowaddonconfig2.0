["arg1"] = "%",
["clColor"] = "ffff7c0a",
},
{
["arg2"] = "Renzik \"le kriss\"",
["type"] = "MONSTER_SAY",
["time"] = 1742694017,
["arg1"] = "Vous avez réussi ! Maintenant, je vais prendre des vacances à Terremine, comme prévu…",
},
{
["arg2"] = "Renzik \"le kriss\"",
["type"] = "MONSTER_SAY",
["time"] = 1742694022,
["arg1"] = "Si on vous demande, on n’a jamais mis les pieds ici, et on ne se connaît pas.",
},
{
["arg2"] = "Inventoriste Tirefer",
["type"] = "MONSTER_SAY",
["time"] = 1742694257,
["arg1"] = "Évocatrice ! À vous voir, vous avez l’air de vous y connaître en matière de mode !",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742694722,
["arg1"] = "Si nous voulons arrêter mon père, nous devons accéder à sa cité fortifiée souterraine.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742694729,
["arg1"] = "Heureusement, la monstruosité volante qui patrouille dans la zone détient un module de contrôle qui peut en ouvrir les portes.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742694736,
["arg1"] = "L’attaquer de front serait la dernière chose à faire, mais désactiver ses relais d’énergie devrait la rendre vulnérable.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742694744,
["arg1"] = "Les nœuds d’énergie sont disséminés partout dans la casse. J’ai calibré mes capteurs pour qu’ils les détectent quand vous passez à proximité.",
},
{
["arg2"] = "Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1742694751,
["arg1"] = "Donc on va farfouiller dans la crasse pour chercher des nœuds qui ne sont peut-être même pas là ?",
},
{
["arg2"] = "Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1742694758,
["arg1"] = "Tout en évitant une machine volante tueuse pour pouvoir pénétrer dans une forteresse qui a ENCORE PLUS de machines tueuses ?",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742694766,
["arg1"] = "Votre résumé est exact.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742694878,
["arg1"] = "Pour arrêter mon père, nous allons devoir infiltrer la ville elle-même. Et cela implique de passer par… le Robodrome.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742695017,
["arg1"] = "L’entrée de la ville se trouve juste de l’autre côté de cette arène.",
},
{
["arg2"] = "Prince Erazmin",
["type"] = "MONSTER_SAY",
["time"] = 1742695020,
["arg1"] = "Vous allez devoir tenir bon le temps qu’on se fraye un chemin jusqu’à la porte.",
},
{
["arg2"] = "Unotre-Archimonde",
["type"] = "SAY",
["time"] = 1742695022,
["arg1"] = "Retourneur d’adversaire sur Unotre",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1742695024,
["arg1"] = "C’est du tout cuit, mon gars. Je mise vingt pièces d’or sur Gnomastoc !",
},
{
["arg2"] = "Gila Filkistouch",
["type"] = "MONSTER_SAY",
["time"] = 1742695029,
["arg1"] = "Mais… s’ils gagnent, ça veut dire qu’on va mourir, non ?",
},
{
["arg2"] = "Gazleu",
["type"] = "MONSTER_SAY",
["time"] = 1742695033,
["arg1"] = "Si je ne peux pas parier sur un combat gagné d’avance, c’est comme si j’étais déjà mort !",
},
{
["arg2"] = "Unotre-Archimonde",
["type"] = "SAY",
["time"] = 1742695038,
["arg1"] = "Retourneur d’adversaire sur Unotre",
["clColor"] = "ff33937f",
},
{
["arg2"] = "Malganos-Hyjal",
["type"] = "SAY",
["time"] = 1742695054,
["arg1"] = "Poussée maximum sur Malganos",
["clColor"] = "ffc41e3a",
},
{
