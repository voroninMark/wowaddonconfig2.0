["clColor"] = "ff8788ee",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605804,
["arg1"] = "Nous arrivons trop tard… oh, non.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605975,
["arg1"] = "Pauvre enfant… il connaissait les dangers de la magie sauvage, mais il s’y est quand même risqué. Quand nous l’avons trouvé, nous n’avons pas pu endiguer son mal.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605988,
["arg1"] = "Je l’ai donc placé en stase le temps de trouver un remède.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605992,
["arg1"] = "Et puis… je suis morte.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715605997,
["arg1"] = "Vous avez fait le nécessaire en mettant fin à son calvaire et je vous en remercie.",
},
{
["arg2"] = "Sindragosa",
["type"] = "MONSTER_SAY",
["time"] = 1715606005,
["arg1"] = "Si je ne suis plus qu’un simulacre, il fut un temps où j’étais mère. Laissez-moi pleurer en paix.",
},
{
["arg2"] = "Brigita",
["type"] = "MONSTER_SAY",
["time"] = 1715606041,
["arg1"] = "Bienvenue au Bélier rôti ! Prenez place.",
},
{
["arg1"] = " ",
},
{
["arg1"] = " ",
},
{
["arg1"] = "Log commencé pour Oit le 05/13/2024 à 16:59:03.",
["type"] = "SYSTEM",
},
{
["arg2"] = "Toddy Bourbon",
["type"] = "MONSTER_SAY",
["time"] = 1715612547,
["arg1"] = "Les montagnes règnent ici sans partage. Plantez-y nos bannières, symboles des fabuleuses découvertes du Dracaret !",
},
{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_SAY",
["time"] = 1715612886,
["arg1"] = "Bien. Vous voilà.",
},
{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_SAY",
["time"] = 1715612889,
["arg1"] = "J’accepte volontiers la rage d’Ohn’ahra. C’est quand les vents se taisent que le pire est à craindre.",
},
{
["arg2"] = "Khanam matra Sarest",
["type"] = "MONSTER_SAY",
["time"] = 1715612897,
["arg1"] = "Les Teeraïs, les Shikaars et les Ohn’irs doivent s’unir pour la libérer et éliminer le khan Balakar.",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715612899,
["arg1"] = "En l’état actuel des choses, il m’est impossible de soutenir la khanam matra.",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715612904,
["arg1"] = "Le proto-dragon Granyth était presque à notre portée quand les troupes de Balakar nous sont tombées dessus.",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715612910,
["arg1"] = "Nous devons reprendre nos armes de guerre et repousser les Nokhuds.",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715612914,
["arg1"] = "Quand le sang de Granyth imprégnera ces terres, nous pourrons faire cause commune.",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715612928,
["arg1"] = "Bien joué, continuez à reprendre les armes ! Il en reste deux !",
},
{
["arg2"] = "Cousin Mains Lentes",
["type"] = "MONSTER_SAY",
["time"] = 1715613052,
["arg1"] = "C’est dangereux d’y aller tout seul ?",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715613084,
["arg1"] = "On y est presque ! Occupez-vous de la dernière !",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715613148,
["arg1"] = "Le rapport de forces est inversé ! Les armes sont à nous !",
},
{
["arg2"] = "Khan Sansok",
["type"] = "MONSTER_SAY",
["time"] = 1715613169,
["arg1"] = "Granyth a atterri ! C’est le moment de frapper !",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613337,
["arg1"] = "Blasphème ! Les Nokhuds ont utilisé le chant d’Ohn’ahra pour invoquer un avatar de la tempête.",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613344,
["arg1"] = "La tempête doit être calmée et l’élémentaire qui l’anime vaincu avant que les Ohn’irs puissent rejoindre la khanam matra.",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613352,
["arg1"] = "Leurs complices primalistes ont placé des totems qui protègent les éléments déchaînés. Trouvez-les et détruisez-les.",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613363,
["arg1"] = "Une idole blasphématoire s’il en est. Continuez sur votre lancée.",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613393,
["arg1"] = "Le pouvoir des Primalistes s’affaiblit.",
},
{
["arg2"] = "Wilaxp-Archimonde",
["type"] = "SAY",
["time"] = 1715613428,
["arg1"] = "Chaîne d’éclairs sur Wilaxp",
["clColor"] = "ffffffff",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613469,
["arg1"] = "Encore un totem ! Vite !",
},
{
["arg2"] = "Khan Tigari",
["type"] = "MONSTER_SAY",
["time"] = 1715613519,
["arg1"] = "Le dernier totem est détruit. Éliminez vite l’avatar de la tempête !",
},
{
["arg2"] = "Bokou",
["type"] = "MONSTER_SAY",
["time"] = 1715613708,
["arg1"] = "Le clan des Uhkels s’est allié aux Nokhuds et aujourd’hui, il va regretter amèrement sa décision.",
},
{
["arg2"] = "Bokou",
["type"] = "MONSTER_SAY",
["time"] = 1715613716,
["arg1"] = "Ces misérables ont profané les sépultures de nos ancêtres Teera et Maruuk.",
},
{
["arg2"] = "Bokou",
["type"] = "MONSTER_SAY",
["time"] = 1715613721,
["arg1"] = "Anéantissez ces hérétiques, que nos ancêtres retrouvent le repos avant que Balakar ne les force à se battre pour lui.",
},
{
["arg2"] = "Maruuk",
["type"] = "MONSTER_SAY",
["time"] = 1715614091,
["arg1"] = "Le repos… enfin…",
},
{
["arg2"] = "Teera",
["type"] = "MONSTER_SAY",
["time"] = 1715614096,
["arg1"] = "Protégez… mes enfants…",
},
{
["arg2"] = "Bokou",
["type"] = "MONSTER_SAY",
["time"] = 1715614107,
["arg1"] = "Balakar ne mérite aucune pitié. Les Teeraïs vont rejoindre notre khan au bastion Nokhudon.",
},
{
["arg2"] = "Yuve-ArgentDawn",
