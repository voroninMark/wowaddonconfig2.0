["names"] = {
},
["events"] = "NS_VENOM_NOVA_YOU",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        local num = math.random(1, 5)\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            marker = \"{rt\"..num..\"}\",\n            num = num,\n            expirationTime = GetTime()+8,\n            autoHide = true,\n        }\n        return true\n        \n    elseif e == \"NS_VENOM_NOVA_YOU\" and ... then\n        local num = ...\n        local duration = 3+(num*1.4) -- star triggers at -1 of the cast, every other mark ~1.4s apart\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            expirationTime = duration+GetTime(),\n            autoHide = true,\n        }\n        return true        \n    end\nend",
