},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    if t[4] then -- If in Rested Area\n        return false\n    end\n    \n    local behavior = aura_env.config.maintenance.lightning_shield.behavior\n    \n    if behavior == 1 then -- Show if Applied\n        return t[2]\n    elseif behavior == 2 then -- Show if Missing\n        return t[3] or t[4]\n    else -- Always Show\n        return true\n    end\nend",
["activeTriggerMode"] = -10,
},
