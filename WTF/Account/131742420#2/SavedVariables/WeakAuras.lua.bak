["custom"] = "function(s, e, ...)\n    local timestamp, subevent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID = ... -- full CLEU\n    \n    if spellID == 466248 then\n        if subevent == \"SPELL_AURA_APPLIED\" then\n            local state = {\n                progressType = \"timed\",\n                duration = 15,\n                expirationTime = GetTime()+15,\n                autoHide = true\n            }\n            s:Update(destGUID, state)\n        elseif s[destGUID] then\n            s:Remove(destGUID)\n            \n        end\n    end\nend",
