["displayText"] = "%c",
["customText"] = "function()\nreturn [=[|TInterface\\Icons\\Ability_hunter_mastermarksman:20:20:0|t Test Dummy targets you with |cnERROR_COLOR:[Threat Neutralization]|r!]=]\nend",
