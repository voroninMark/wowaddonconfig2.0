},
["custom"] = "function(s, e, ...)\n    if e == \"NS_OVINAX_PARTNER\" then\n        local _, num = ...\n        SendChatMessage(\"{rt\"..num..\"}\"..\"8\"..\"{rt\"..num..\"}\", \"SAY\")\n        C_Timer.After(2, function() \n                SendChatMessage(\"{rt\"..num..\"}\"..\"6\"..\"{rt\"..num..\"}\", \"SAY\")\n        end)\n        C_Timer.After(4, function()\n                SendChatMessage(\"{rt\"..num..\"}\"..\"4\"..\"{rt\"..num..\"}\", \"SAY\")\n        end)\n        C_Timer.After(6, function()\n                SendChatMessage(\"{rt\"..num..\"}\"..\"2\"..\"{rt\"..num..\"}\", \"SAY\")\n        end)           \n        C_Timer.After(7, function()\n                SendChatMessage(\"{rt\"..num..\"}\"..\"1\"..\"{rt\"..num..\"}\", \"SAY\")\n        end)           \n    end\nend\n\n\n\n\n\n",
