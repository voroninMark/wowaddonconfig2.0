["custom"] = "function(s, e, ...)\n    if e == \"RELOE_HYPERCOIL\" and ... then        \n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = 3+GetTime(),\n            autoHide = true,\n        }   \n        C_Timer.After(18, function()\n                WeakAuras.ScanEvents(\"RELOE_HYPERCOIL\", true)\n        end)\n        return true\n        \n    elseif e == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local u, cast, spellID = ... -- Unit event\n        if spellID == 465432 then\n            C_Timer.After(1.5, function()\n                    WeakAuras.ScanEvents(\"RELOE_HYPERCOIL\", true)\n            end)\n            return true\n        end\n    end\nend",
