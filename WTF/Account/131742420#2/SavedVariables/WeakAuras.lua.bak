["type"] = "custom",
["custom"] = "function()\n    if LWA and LWA.Init then\n        LWA.Init()\n    end\nend",
["custom_type"] = "event",
["custom_hide"] = "timed",
["unit"] = "player",
["events"] = "OPTIONS",
