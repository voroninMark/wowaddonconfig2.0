0.19607844948769,
0.58823531866074,
1,
1,
},
["glow_thickness"] = 4,
["glow_XOffset"] = -1,
["do_glow"] = true,
["glow_action"] = "show",
["use_glow_color"] = true,
["glow_type"] = "Pixel",
["glow_YOffset"] = -1,
