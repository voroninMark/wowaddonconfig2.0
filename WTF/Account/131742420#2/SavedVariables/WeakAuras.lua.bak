["custom"] = "function(s, e, ...)\n    if e == \"UPDATE_EXTRA_ACTIONBAR\" then -- copy from Amirdrassil        \n        if HasExtraActionBar() then\n            local extraPage = GetExtraBarIndex()\n            local slot = extraPage*12 - 11\n            local action, spellID = GetActionInfo(slot)\n            if spellID == 460674 then\n                local state = {\n                    progressType = \"static\",\n                    -- don't think I need to provide literally anything?\n                }\n                s:Update(\"\", state)\n            end\n        elseif s[\"\"] then\n            s:Remove(\"\")\n        end\n        \n    end\nend",
