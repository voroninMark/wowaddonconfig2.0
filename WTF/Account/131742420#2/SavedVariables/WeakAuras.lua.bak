["trigger"] = {
["spellId"] = "",
["matchesShowOn"] = "showOnActive",
["genericShowOn"] = "showOnCooldown",
["names"] = {
},
["duration"] = "",
["subeventPrefix"] = "SPELL",
["custom"] = "function(allstates, event, unit, _, spellID)    \n    if event == \"UNIT_TARGET\"\n    then\n        local _,_,_,_,expirationTime,_,_,_,spellId = UnitCastingInfo(unit)\n        local guid = UnitGUID(unit)\n        if spellId\n        and guid\n        and spellId == 321894\n        and not allstates[guid] then\n            allstates[guid] = {\n                show = true,\n                changed =  true,\n                progressType = \"timed\", \n                duration = expirationTime / 1000 - GetTime(),\n                expirationTime = expirationTime / 1000,\n                unit = WA_ClassColorName(unit..\"target\"),\n                autoHide = true,\n            }\n            return true\n        end\n    elseif event == \"UNIT_SPELLCAST_STOP\" and spellID == 321894 then\n        local state = allstates[UnitGUID(unit)]\n        if state then\n            state.show = false\n            state.changed = true\n            return true\n        end\n    end\nend",
["spellName"] = 0,
["match_count"] = "0",
