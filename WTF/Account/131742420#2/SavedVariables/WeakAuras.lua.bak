["parent"] = "Mug'zee Heads of Security - Bars",
["adjustedMin"] = "",
["cooldownSwipe"] = true,
["sparkRotationMode"] = "AUTO",
["cooldownEdge"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["custom"] = "function(s, e, ...)\n    if e == \"UNIT_SPELLCAST_START\" then\n        local u, cast, spellID = ... -- Unit event\n        if spellID == 472659 and UnitExists(u) then\n            if WeakAuras.CheckRange(u, 8, \"<=\") then\n                local expires = select(4, UnitCastingInfo(u))\n                s[UnitGUID(u)] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = (expires/1000)-GetTime(),\n                    expirationTime = expires/1000,                    \n                    autoHide = true,\n                }\n                return true\n            end\n        end\n    elseif e == \"UNIT_SPELLCAST_STOP\" then\n        local u, cast, spellID = ... -- Unit event\n        if UnitExists(u) then\n            local G = UnitGUID(u)\n            if s[G] then\n                s[G].show = false\n                s[G].changed = true\n                return true\n            end\n        end\n        \n        \n    elseif e == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subevent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID = ... -- full CLEU\n        if s[destGUID] then\n            s[destGUID].show = false\n            s[destGUID].changed = true\n            return true\n        end\n    end\n    \nend\n\n\n",
["events"] = "UNIT_SPELLCAST_START:nameplate CLEU:UNIT_DIED UNIT_SPELLCAST_STOP:nameplate",
