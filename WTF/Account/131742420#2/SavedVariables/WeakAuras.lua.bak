["events"] = "NS_ESSENCE_ALERT",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        local num = math.random(1, 5)\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            marker = \"{rt\"..num..\"}\",\n            num = num,\n            expirationTime = GetTime()+8,\n            autoHide = true,\n        }\n        return true\n        \n    elseif e == \"NS_ESSENCE_ALERT\" then\n        local num = ...\n        local duration = 10\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            num = num,\n            expirationTime = duration+GetTime(),\n            autoHide = true,\n        }\n        return true        \n    end\nend",
