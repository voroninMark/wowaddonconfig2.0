["spellName"] = 0,
["subeventSuffix"] = "_CAST_START",
["type"] = "custom",
["customDuration"] = "-- trigger1 display info\nfunction()\n    return (aura_env.blood_shield / UnitHealthMax(\"player\")), 50, 1\nend",
