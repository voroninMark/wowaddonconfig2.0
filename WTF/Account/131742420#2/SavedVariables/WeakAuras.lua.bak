["custom"] = "aura_env.num = 2\naura_env.color = {2, 2, 1, 4, 3, 2, 1, 4, 3}\n\naura_env.numflip = 3\naura_env.colorflip = {3, 3, 2, 1, 4, 3, 2, 1, 4}",
["do_custom"] = true,
