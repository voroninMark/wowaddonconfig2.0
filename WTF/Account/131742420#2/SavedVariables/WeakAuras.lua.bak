["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        local i = 1\n        s[i] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 4,\n            expirationTime = 4+GetTime(),\n            text = i and i > 0 and\"{rt\"..i..\"} HIGH ENERGY {rt\"..i..\"}\" or \"HIGH ENERGY AMPLIFIER\",\n            autoHide = true,\n        }\n        return true\n    elseif e == \"NS_AMPLIFIER_ALERT\" and ... then\n        local i = ...\n        s[i] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 4,\n            expirationTime = 4+GetTime(),\n            text = i and i > 0 and\"{rt\"..i..\"} HIGH ENERGY {rt\"..i..\"}\" or \"HIGH ENERGY AMPLIFIER\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
