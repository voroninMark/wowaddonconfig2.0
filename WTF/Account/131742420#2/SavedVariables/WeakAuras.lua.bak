["name"] = "Enable TTS",
["key"] = "enableTTS",
["default"] = true,
["width"] = 1,
},
{
["text"] = "|cFFFF0000WARNING!|r TTS is always playing from system default (wow bug?)",
["type"] = "description",
["fontSize"] = "medium",
["width"] = 1,
},
{
["width"] = 2,
["type"] = "input",
["name"] = "TTS Message",
["default"] = "{spellName:name} in {progress}",
["key"] = "ttsMessage",
["length"] = 10,
["multiline"] = false,
["useLength"] = false,
},
{
["fontSize"] = "medium",
["type"] = "description",
["text"] = "You can have text replacement from the properties of the timer with {PROPERTYNAME} and a priority from left to right with colon {spellName:name} and check for the first none empty. Check the WAGO page for more information\n\n|cFF33FF00TTS is following the Ingame Option for Text-To-Speech\nTo change few settings read bellow|r\n\nYou can set the volume of the TTS with following command\n/run C_TTSSettings.SetSpeechVolume(n)\nWhere default n is 100 and goes from 0-100 on volume.\n\nYou can also set the TTS speech speed with following in chat\n/run C_TTSSettings.SetSpeechRate(n)\nWhere default n is 0 and negative is slower and higher is faster\n\nAnd select voice with\n/run C_TTSSettings.SetVoiceOption(0, voiceID)\nWhere voiceID is from 0 ... X depending on your installed TTS voices           \n",
["width"] = 2,
},
{
["useName"] = true,
["text"] = "KEYWORDS",
["type"] = "header",
["width"] = 2,
},
{
["fontSize"] = "medium",
["type"] = "description",
["text"] = "Matching keywords are what the WA is looking for to show it to you, if the text contains any of the keywords it will show up.\n\nThe following are dynamic replacement for text\n\n{name} = Character name e.g Kazeshinu\n{mygroup} = Your group number e.g 1/2/3/...\n{class} = Your class e.g Druid/Mage/Shaman/...\n{spec} = Your spec e.g Restoration/Frost/Restoration/... (Yes Druid is same as shaman)\n{role} = DAMAGER/TANK/HEALER\n{type} = Melee/Ranged\n|cFFFF0000DON'T TOUCH IF YOU ARE NOT SURE|r",
["width"] = 2,
},
{
["type"] = "input",
["useDesc"] = true,
["width"] = 2,
["multiline"] = true,
["default"] = "{name},class:{class},group:{mygroup},spec:{spec},role:{role},everyone,type:{type}",
["key"] = "keyword",
["name"] = "Matching Keywords (comma seperated)",
["length"] = 10,
["desc"] = "Matching keywords seperated by comma",
["useLength"] = false,
},
{
["type"] = "input",
["useDesc"] = true,
["width"] = 2,
["desc"] = "Matching keywords seperated by comma",
["key"] = "ignorekeyword",
["default"] = "{spell:123},{spell:321}",
["name"] = "Ignore Keywords (comma seperate)",
["length"] = 10,
["multiline"] = false,
["useLength"] = false,
},
{
["useName"] = true,
["text"] = "SHARED NOTE",
["type"] = "header",
["width"] = 1,
},
{
["type"] = "toggle",
["key"] = "disableShared",
["default"] = false,
["name"] = "Disable Shared Note",
["useDesc"] = false,
["width"] = 1,
},
{
["type"] = "toggle",
