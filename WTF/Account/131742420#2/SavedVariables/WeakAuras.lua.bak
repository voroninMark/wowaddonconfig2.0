},
["custom"] = "function(s, e, ...)\n    \n    if e == \"NS_COURT_DISPEL_ME\" and ... then\n        local pos = ...\n        if pos == 0 and s[\"\"] then\n            s[\"\"].show = false\n            s[\"\"].changed = true\n            return true\n        elseif pos ~= 0 then\n            s[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"static\",\n                pos = pos,\n                autoHide = false,\n            }         \n            return true\n        end\n    end\nend",
