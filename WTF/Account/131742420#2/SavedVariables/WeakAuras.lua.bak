["debuffType"] = "HELPFUL",
["type"] = "custom",
["events"] = "STATUS",
["custom_type"] = "status",
["check"] = "event",
["custom"] = "function(event)\n    if \"STATUS\" == event then\n        aura_env.resources = nil\n        \n        C_Timer.After(0.05, function()\n                WeakAuras.ScanEvents(\"LWA_INIT\")\n        end)\n    end\nend",
["custom_hide"] = "timed",
