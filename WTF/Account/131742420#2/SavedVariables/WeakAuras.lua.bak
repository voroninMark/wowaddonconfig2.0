["[ACoE-BOSS02] Burrow Charge (You)"] = {
["iconSource"] = 0,
["wagoID"] = "tcIVwLsy9",
["parent"] = "Regular Icons",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
