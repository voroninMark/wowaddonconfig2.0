["displayText"] = "Dispel %pos %c\n",
["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then return end\n    local now = GetTime()\n    if not aura_env.last or now > aura_env.last then\n        aura_env.last = now + 1.25\n        SendChatMessage(aura_env.texts[aura_env.state.pos], \"YELL\")\n    end\nend\n\n\n",
