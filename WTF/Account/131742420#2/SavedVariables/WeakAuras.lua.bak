{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Combat Log",
["unit"] = "player",
["events"] = "NS_GATE_LIST NS_GATE_STOP NS_GATE_STOP_ALL",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        for i=1, 2 do\n            s[i] = {\n                show = true,\n                progressType = \"timed\",\n                unit = \"player\",\n                duration = 10,\n                expirationTime = expires,\n                num = i == 1 and \"Left\" or \"Right\",\n                changed = true,\n                autoHide = true,\n            }\n        end\n        return true\n        \n    elseif e == \"NS_GATE_LIST\" and ... then\n        local unit, num, expires = ...\n        local G = UnitGUID(unit)\n        s[G] = {\n            show = true,\n            progressType = \"timed\",\n            unit = unit,\n            duration = 10,\n            expirationTime = expires,\n            num = num == 1 and \"Left\" or \"Right\",\n            changed = true,\n            autoHide = true,\n        }\n        return true\n    elseif e == \"NS_GATE_STOP\" and ... then\n        local G = ...\n        if s[G] then\n            s[G].show = false\n            s[G].changed = true\n            return true\n        end\n    elseif e == \"NS_GATE_STOP_ALL\" and ... then\n        for _, v in pairs(s) do\n            v.show = false\n            v.changed = true\n        end\n        return true \n    end\nend\n\n\n",
