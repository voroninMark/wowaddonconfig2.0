["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        local num = math.random(1, 4)\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            marker = \"{rt\"..num..\"}\",\n            num = num,\n            expirationTime = GetTime()+8,\n            autoHide = true,\n        }\n        return true\n        \n    elseif e == \"NS_REACTIVE_TOXIN\" then\n        local num, duration = ...\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            marker = \"{rt\"..num..\"}\",\n            num = num,\n            expirationTime = duration+GetTime(),\n            autoHide = true,\n        }\n        return true\n        \n    end\nend",
