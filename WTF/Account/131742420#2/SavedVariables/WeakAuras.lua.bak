["custom"] = "function(event, arg1)\n    local spec = GetSpecialization()\n    local cd = aura_env.region.colorState:find(\"cd$\") and \"cd\" or \"\"\n    \n    if not spec or 5 == spec then\n        spec = 1\n    end\n    \n    aura_env.spec = ({\"blood\", \"frost\", \"unholy\"})[spec]\n    aura_env.region.colorState = aura_env.spec .. cd\n    \n    return true\nend",
