["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_START:boss1",
["names"] = {
},
["check"] = "event",
["custom"] = "function(allstates, event, _, _, spellID)\n    if event == \"ENCOUNTER_START\" then\n        aura_env.counter = 0\n        allstates[257882] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 7.2,\n            expirationTime = 7.2 + GetTime(),\n            autoHide = true\n        }\n        return true\n        \n    elseif event == \"UNIT_SPELLCAST_START\" and spellID == 257882 then\n        aura_env.counter = aura_env.counter + 1\n        local duration = aura_env.counter % 2 == 1 and 29.1 or 20.7\n        allstates[spellID] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            expirationTime = duration + GetTime(),\n            autoHide = true\n        }\n        return true\n    end\nend",
["subeventPrefix"] = "SPELL",
["customVariables"] = "{\nexpirationTime = true\n}",
