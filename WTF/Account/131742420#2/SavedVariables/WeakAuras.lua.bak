["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["spellIds"] = {
},
["custom"] = "function(s, e, ...)\n    local duration, _, phase = select(3, ...)\n    if e == \"NS_OVINAX_EGG\" and duration then\n        s[\"\"] = {\n            show = true,\n            duration = duration,\n            expirationTime = GetTime()+duration,\n            phase = phase,\n            autoHide = true,\n            show = true,\n            changed = true,\n        }\n        return true\n    elseif e == \"NS_OVINAX_HIDE\" and s[\"\"] then\n        s[\"\"].show = false\n        s[\"\"].changed = true\n        return true \n    elseif e == \"NS_OVINAX_EGGDUR\" and s[\"\"] then\n        local dur, expires = ...\n        if dur then\n            s[\"\"].duration = dur\n            s[\"\"].expirationTime = expires\n            s[\"\"].changed = true\n            return true\n        end\n    end\nend",
["events"] = "NS_OVINAX_EGG NS_OVINAX_HIDE NS_OVINAX_EGGDUR",
