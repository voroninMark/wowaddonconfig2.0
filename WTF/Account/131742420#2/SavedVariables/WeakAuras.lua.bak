},
["spellIds"] = {
},
["custom"] = "function(s, e, ...)\n    if e == \"NS_ESSENCE_YOU\" then\n        local aura_env = aura_env\n        C_Timer.After(4, function() \n                if not WA_GetUnitAura(\"player\", aura_env.debuff, aura_env.filter) then\n                    SendChatMessage(\"Taking Orb\", \"SAY\")\n                end\n        end)\n        C_Timer.After(6, function()\n                if not WA_GetUnitAura(\"player\", aura_env.debuff, aura_env.filter) then\n                    SendChatMessage(\"Taking Orb\", \"SAY\")\n                end\n        end)\n        C_Timer.After(8, function()\n                if not WA_GetUnitAura(\"player\", aura_env.debuff, aura_env.filter) then\n                    SendChatMessage(\"Taking Orb\", \"SAY\")\n                end\n        end)\n    end\nend\n\n\n\n\n\n",
