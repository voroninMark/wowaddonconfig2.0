["events"] = "NS_ROLLING_RUBBSIH",
["check"] = "event",
["custom"] = "function(s, e, ...)\n    if e == \"NS_ROLLING_RUBBSIH\" then        \n        local num, _, count = ...\n        local mark = aura_env.num[num][count]\n        local text = \"{rt\"..mark..\"}\"\n        SendChatMessage(text, \"SAY\")\n        SendChatMessage(text, \"RAID\")\n        C_Timer.After(2, function() \n                SendChatMessage(text, \"SAY\")\n        end)\n        C_Timer.After(4, function()\n                SendChatMessage(text, \"SAY\")\n        end)\n    end\nend",
