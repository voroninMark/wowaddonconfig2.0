["zoom"] = 0,
["semver"] = "2.0.8",
["tocversion"] = 110002,
["id"] = "Kaze MRT Timers Logic 2",
["selfPoint"] = "CENTER",
["useCooldownModRate"] = true,
["anchorFrameType"] = "SCREEN",
["frameStrata"] = 1,
["config"] = {
["disableShared"] = false,
["override"] = {
{
