["events"] = "NS_VENOM_NOVA_ALERT",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        local num = math.random(1, 5)\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            marker = \"{rt\"..num..\"}\",\n            num = num,\n            expirationTime = GetTime()+8,\n            autoHide = true,\n        }\n        return true\n        \n    elseif e == \"NS_VENOM_NOVA_ALERT\" then\n        local _, num = ...\n        if num and num ~= 0 then -- prevent showing from outdated versions\n            local duration = 10\n            s[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = duration,\n                marker = \"{rt\"..num..\"}\",\n                num = num,\n                expirationTime = duration+GetTime(),\n                autoHide = true,\n            }\n            return true     \n        end\n    end\nend",
