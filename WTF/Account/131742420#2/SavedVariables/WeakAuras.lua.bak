["custom_type"] = "stateupdate",
["duration"] = "5",
["unit"] = "player",
["custom"] = "function(s, e, status)\n    if e == \"NS_MACRO_PRESS_PERSONAL\" and status then\n        if status == 3 and s[\"\"] then -- 3 = hide\n            s[\"\"].show = false\n            s[\"\"].changed = true\n        elseif status < 3 then -- 1 = pressed, 2 = not pressed\n            s[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"static\",\n                autoHide = true,\n                status = status,\n            }\n            return true\n        end\n    end\nend\n\n\n",
["customVariables"] = "{\n    status = \"number\",\n}",
