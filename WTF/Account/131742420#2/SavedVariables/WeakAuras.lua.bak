["subeventPrefix"] = "SPELL",
["custom"] = "function(s, e, ...)\n    if e == \"RELOE_HOTHOTHEAT\" and ... then        \n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = 5+GetTime(),\n            autoHide = true,\n        }   \n        C_Timer.After(12, function()\n                WeakAuras.ScanEvents(\"RELOE_HOTHOTHEAT\", true)\n        end)\n        return true\n        \n    elseif e == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local u, cast, spellID = ... -- Unit event\n        if spellID == 465322 then\n            s[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 5,\n                expirationTime = 5+GetTime(),\n                autoHide = true,\n            }   \n            C_Timer.After(12, function()\n                    WeakAuras.ScanEvents(\"RELOE_HOTHOTHEAT\", true)\n            end)\n            return true\n        end\n    end\nend",
