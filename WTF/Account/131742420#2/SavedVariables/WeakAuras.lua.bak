["custom"] = "if aura_env.config.CastRingClassColor then\n    local c = RAID_CLASS_COLORS[select(2,UnitClass(\"player\"))]\n    aura_env.region:Color(c.r, c.g, c.b,1)\nelse\n    local color = aura_env.config.CastRingColor\n    aura_env.region:Color(color[1], color[2], color[3],color[4])\nend",
