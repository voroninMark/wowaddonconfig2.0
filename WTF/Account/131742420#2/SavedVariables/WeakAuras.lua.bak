["events"] = "NS_OVINAX_PARTNER",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        \n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            marker = \"{rt\"..math.random(1, 4)..\"}\",\n            expirationTime = GetTime()+8,\n            autoHide = true,\n        }\n        return true\n        \n    elseif e == \"NS_OVINAX_PARTNER\" then\n        local _, num, duration = ...\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            number = num,\n            marker = \"{rt\"..num..\"}\",\n            expirationTime = GetTime()+duration,\n            autoHide = true,\n        }\n        return true\n        \n    end\nend",
