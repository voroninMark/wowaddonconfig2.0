["Breath Complete"] = {
["outline"] = "OUTLINE",
["wagoID"] = "efRZ4pfaV",
["authorOptions"] = {
},
["displayText"] = "%c",
["customText"] = "function()\n    if aura_env.duration and aura_env.duration > 0 then\n        local damage = aura_env.amount or 0\n        local damageString\n        damageString = string.format(\"%.2f\", (damage / 1000))..\"K\"\n        aura_env.amount = 0\n        return \"Breath Ended\\nDamage: |cFF00FF00\"..damageString..\"|r\\nDuration: |cFFFFFF00\"..string.format(\"%.2f\", aura_env.duration)..\"|r\"\n    end\n    return \"\"\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["customTextUpdate"] = "event",
["url"] = "https://wago.io/efRZ4pfaV/1",
["actions"] = {
["start"] = {
["do_glow"] = false,
},
["finish"] = {
["do_message"] = false,
},
["init"] = {
["custom"] = "",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["custom_type"] = "event",
["duration"] = "8",
["genericShowOn"] = "showOnActive",
["unit"] = "player",
["names"] = {
},
["events"] = "WA_DK_BREATH_OF_SINDRAGOSA_END,COMBAT_LOG_EVENT_UNFILTERED",
["custom"] = "function(event, ...)\n    if event == \"WA_DK_BREATH_OF_SINDRAGOSA_END\" then\n        aura_env.duration = select(1, ...)\n        return true\n    else\n        local type = select(2, ...)\n        if type == \"SPELL_DAMAGE\" then\n            local spellId, _, _, amount = select(12, ...)\n            if spellId == 155166 then\n                aura_env.amount = (aura_env.amount or 0) + amount\n            end\n        elseif type == \"SPELL_ABSORBED\" then\n            local spellId, _, _, _, _, _, _, _, _, _, amount = select(12, ...)\n            if spellId == 155166 then\n                aura_env.amount = (aura_env.amount or 0) + amount\n            end\n        end\n    end\n    return false\nend",
["spellIds"] = {
},
