},
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        \n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 8,\n            name = NSAPI and NSAPI:Shorten(\"player\", 8) or WA_ClassColorName(\"player\"),\n            expirationTime = GetTime()+8,\n            autoHide = true,\n        }\n        return true\n        \n    elseif e == \"NS_OVINAX_PARTNER\" then\n        local partner,_ ,duration = ...\n        partner = NSAPI and NSAPI:Shorten(partner, 8) or WA_ClassColorName(partner)\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = duration,\n            name = partner,\n            expirationTime = GetTime()+duration,\n            autoHide = true,\n        }\n        return true\n        \n    end\nend",
