["url"] = "https://wago.io/ZbjlsgMkp/49",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "local MaxActuationPoint = .5 -- 0 for always visible\nlocal duration = .4\nlocal Density = 0.008\nlocal ElementCap = 120\nlocal PastCursorX, PastCursorY, PresentCursorX, PresentCursorY = 0, 0, 0, 0\n\n\naura_env.Trail = function(self)\n    local elapsed\n    \n    if not self.present then\n        self.present = GetTime()\n        elapsed = 0\n    else\n        elapsed = GetTime() - self.present\n        self.present = GetTime()\n    end\n    \n    self.MaxDensity = (self.MaxDensity or 0) + elapsed\n    \n    if self.MaxDensity >= Density then\n        self.MaxDensity = 0\n        \n        PastCursorX = PresentCursorX\n        PastCursorY = PresentCursorY\n        PresentCursorX, PresentCursorY = GetCursorPosition()\n        \n        local x = PresentCursorX - PastCursorX\n        local y = PresentCursorY - PastCursorY\n        local ActuationPoint = math.sqrt(x * x + y * y)\n        \n        if ActuationPoint >= MaxActuationPoint and #self.elements > 0 then\n            --NewElement\n            \n            local element = self.elements[#self.elements]\n            \n            self.elements[#self.elements] = nil\n            self.elementsGenerated[#self.elementsGenerated + 1] = element\n            \n            element.duration = duration\n            \n            local x, y = GetCursorPosition()\n            local Scale = UIParent:GetEffectiveScale()\n            element.x = x / Scale\n            element.y = y / Scale\n            \n            if aura_env.config.TrailClassColor then\n                local c = RAID_CLASS_COLORS[select(2,UnitClass(\"player\"))]\n                element:SetVertexColor(c.r, c.g, c.b,1)\n                --elseif aura_env.config.RainbowPuke then\n                --    element:SetVertexColor(math.random(), math.random(), math.random())            \n            else\n                local color = aura_env.config.TrailColor\n                element:SetVertexColor(color[1], color[2], color[3], color[4])\n            end\n            \n            element:SetTexture(aura_env.region.texture:GetTexture())\n            element:SetSize(Scale,Scale)\n            element:SetBlendMode(\"ADD\")\n            element:SetPoint(\"CENTER\", UIParent, \"BOTTOMLEFT\", element.x, element.y)\n            element:Show()\n        end\n        \n        -- Update existing elements\n        for i = #self.elementsGenerated, 1, -1 do\n            \n            --if aura_env.config.BlingBling then\n            --    self.elementsGenerated[i]:SetVertexColor(math.random(), math.random(), math.random())            \n            --end if\n            \n            self.elementsGenerated[i].duration = self.elementsGenerated[i].duration - elapsed\n            \n            if self.elementsGenerated[i].duration < 0 then\n                self.elementsGenerated[i]:Hide()\n                self.elements[#self.elements + 1] = table.remove(self.elementsGenerated, i)\n            else\n                local ElementScale = math.max(0.1, self.elementsGenerated[i].duration / duration)\n                \n                self.elementsGenerated[i]:SetSize(50 * ElementScale, 50 * ElementScale)\n                self.elementsGenerated[i]:SetPoint(\"CENTER\", UIParent, \"BOTTOMLEFT\", self.elementsGenerated[i].x, self.elementsGenerated[i].y)    \n            end\n            \n        end\n    end\nend\n\n\n--Main Init\nif aura_env.elements == nil then\n    \n    aura_env.elements = {}\n    aura_env.elementsGenerated = {}\n    \n    for i = 1, ElementCap, 1 do\n        aura_env.elements[i] = UIParent:CreateTexture(nil)\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["spellIds"] = {
},
["custom"] = "function(event,button)\n    \n    if aura_env.config.HideOnRightClick then\n        if event == \"GLOBAL_MOUSE_UP\" then\n            if button == \"RightButton\" then\n                return true\n            end\n        end\n        \n    elseif aura_env.config.KeyOption > 1 then\n        \n        if aura_env.config.KeyOption == 2 and IsLeftAltKeyDown() then\n            return true \n        elseif aura_env.config.KeyOption == 4 and IsLeftControlKeyDown() then\n            return true\n        elseif aura_env.config.KeyOption == 3 and IsLeftShiftKeyDown() then\n            return true\n        end\n        \n    else\n        return true\n    end \n    \nend\n\n\n\n",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["custom_type"] = "event",
["events"] = "GLOBAL_MOUSE_DOWN,GLOBAL_MOUSE_UP, MODIFIER_STATE_CHANGED,PLAYER_LOGIN,PLAYER_ENTERING_WORLD",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "function(event,button)\n    \n    if aura_env.config.HideOnRightClick then\n        if event == \"GLOBAL_MOUSE_DOWN\" then\n            if button == \"RightButton\" then\n                return true\n            end\n        end \n        \n    elseif aura_env.config.KeyOption > 1 then\n        \n        if aura_env.config.KeyOption == 2 and not IsLeftAltKeyDown() then\n            return true \n        elseif aura_env.config.KeyOption == 4 and not IsLeftControlKeyDown() then\n            return true\n        elseif aura_env.config.KeyOption == 3 and not IsLeftShiftKeyDown() then\n            return true\n        end\n        \n    else\n        return true\n    end \n    \nend\n\n\n\n",
},
},
{
["trigger"] = {
["type"] = "custom",
["custom"] = "function(...)\n    if aura_env.config.ShowTrail == true then\n        aura_env:Trail()\n    end\n    \n    \n    return true\nend\n\n\n",
["custom_type"] = "stateupdate",
["check"] = "update",
["unit"] = "player",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t) \n    return aura_env.config.ShowTrail == true and (t[1] and t[2])\nend\n",
["activeTriggerMode"] = -10,
},
["internalVersion"] = 83,
["animation"] = {
["start"] = {
["colorR"] = 1,
["duration"] = "1000",
["alphaType"] = "custom",
["colorA"] = 1,
["colorG"] = 1,
["alphaFunc"] = "function(progress, start, delta)\n    \n    --[[if aura_env.config[\"HideOnRightClick\"] then\n        if IsMouseButtonDown(\"RightButton\") then\n            aura_env.region:Color(255,255,255,0)\n            return 0\n        else\n            aura_env.region:Color(255,255,255,255)\n            return 1\n        end\n    end\n]]--\n    \n    if aura_env.config[\"ShowOnKeyPress\"] then\n        \n        if aura_env.config[\"KeyOption\"] == 1 then\n            if IsLeftAltKeyDown() then\n                aura_env.region:Color(255,255,255,1)\n                return 1\n            else\n                aura_env.region:Color(255,255,255,0)\n                return 0\n            end\n        elseif  aura_env.config[\"KeyOption\"] == 2 then\n            if IsLeftShiftKeyDown() then\n                aura_env.region:Color(255,255,255,1)\n                return 1\n            else\n                aura_env.region:Color(255,255,255,0)\n                return 0\n            end\n        else\n            if IsLeftControlKeyDown() then\n                aura_env.region:Color(255,255,255,1)\n                return 1\n            else\n                aura_env.region:Color(255,255,255,0)\n                return 0\n            end\n        end\n        \n    end\n    \n    \nend\n\n\n",
