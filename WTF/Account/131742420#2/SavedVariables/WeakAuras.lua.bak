["Northern Sky Database & Functions"] = {
["outline"] = "OUTLINE",
["wagoID"] = "gLfyc_GaD",
["authorOptions"] = {
{
["desc"] = "Choose which voice to use for TTS sounds. Gives you a preview sound when changing sounds",
["type"] = "select",
["key"] = "TTS",
["values"] = {
"1",
"2",
"3",
"4",
"5",
},
["default"] = 2,
["useDesc"] = true,
["name"] = "TTS Voice",
["width"] = 0.5,
},
{
["useName"] = false,
["type"] = "header",
["text"] = "",
["width"] = 1,
