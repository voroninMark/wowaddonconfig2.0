["easeType"] = "none",
},
["main"] = {
["colorR"] = 1,
["scalex"] = 1,
["alphaType"] = "custom",
["colorB"] = 0,
["colorG"] = 0.23137256503105,
["alphaFunc"] = "function(progress, start, delta)\n    return start + (progress * delta)\nend\n",
["use_translate"] = false,
["use_alpha"] = false,
["type"] = "none",
["duration_type"] = "seconds",
["easeType"] = "none",
["translateFunc"] = "function(progress, startX, startY, deltaX, deltaY)\n    return startX + (progress * deltaX), startY + (progress * deltaY)\nend\n",
["scaley"] = 1,
["alpha"] = 0,
["x"] = 0,
["y"] = 0,
["colorType"] = "pulseHSV",
["rotate"] = 0,
["translateType"] = "straightTranslate",
["colorFunc"] = "function(progress, r1, g1, b1, a1, r2, g2, b2, a2)\n    local angle = (progress * 2 * math.pi) - (math.pi / 2)\n    local newProgress = ((math.sin(angle) + 1)/2);\n    return WeakAuras.GetHSVTransition(newProgress, r1, g1, b1, a1, r2, g2, b2, a2)\nend\n",
["easeStrength"] = 3,
["use_color"] = false,
["colorA"] = 1,
