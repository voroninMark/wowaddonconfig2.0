["check"] = "event",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        local me = math.random(0, 2) > 1\n        local expires = 8\n        local state = {\n            progressType = \"timed\",\n            duration = expires-GetTime(),\n            me = me,\n            expirationTime = expires,\n            autoHide = true,\n        }\n        s:Update(\"\", state)\n    else\n        local num, me, expires = ...\n        if num == 2 or num == 8 then\n            local state = {\n                progressType = \"timed\",\n                duration = expires-GetTime(),\n                me = me,\n                expirationTime = expires,\n                autoHide = true,\n            }\n            s:Update(\"\", state)\n        end\n    end\nend\n\n\n",
